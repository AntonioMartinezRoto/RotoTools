<Window
    x:Class="RotoTools.Suite.Views.Exportador.ExportacionWinPerfilWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Exportación a WinPerfil"
    Width="660" Height="820"
    MinWidth="560" MinHeight="600"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource RotoContentBackgroundBrush}"
    KeyDown="Window_KeyDown">

    <!--
        Sustituye a ExportacionWinPerfil.cs/.Designer.cs (WinForms): igual que ControlCambiosPage,
        GenerarExportacion (el método que realmente construye el Excel con NPOI, ~250 líneas) es
        casi en su totalidad lógica de negocio autocontenida que solo lee unos pocos controles de
        WinForms en sus bordes (chkList_Sets.CheckedItems, cmb_Perfil/cmb_Sistema/cmb_PerfilAlu/
        cmb_Color.Text, y los campos privados _perfilesListSelected/_perfilesAluListSelected/
        _filtroListaPerfilesActivo/_filtroListaPerfilesAluActivo) — así que se reutiliza tal cual
        por reflexión sobre una instancia OCULTA de RotoTools.ExportacionWinPerfil (nunca visible),
        con el mismo criterio ya usado en ConectorHerrajePage/ControlCambiosPage. Ver
        ExportacionWinPerfilWindow.xaml.cs (CrearFormularioOculto) para el detalle completo de qué
        se inyecta por reflexión. RotoTools.csproj no se modifica en absoluto.

        El original era un único formulario fijo (651x1024, FixedSingle) con 4 combos de filtro
        (Perfil/Perfil ALU/Sistema/Color), 2 botones que abren un diálogo de filtro de perfiles
        reutilizable (ExportacionPerfilesFiltroWindow.xaml, antes ExportacionWinPerfilListaPerfiles),
        una lista marcable de Sets con buscador y "Seleccionar todos", una barra de progreso, y un
        botón de exportar (antes solo icono, sin texto). F11 abre un diálogo de opciones de columnas
        (ExportacionOpcionesWindow.xaml, antes ExportacionOpciones) — el original no tenía NINGÚN
        botón visible para abrirlo, solo el atajo de teclado; aquí se mantiene F11 como único
        disparador real (no se añade un botón para abrirlo, ver el comentario en
        ExportacionOpcionesWindow.xaml), pero sí se añade un pequeño texto de ayuda (LblOpciones,
        no existía en el original) para que el atajo sea descubrible al probar el módulo.

        La etiqueta "Perfil ALU" (lbl_ProfileAlu) nunca pasaba por LocalizationManager en el
        original (CargarTextos no la toca) — se mantiene como literal fijo en español aquí también.

        La insignia de la cabecera usa el logotipo real de WinPerfil (mismo PNG que la tarjeta de
        ExportadorPage, ver su comentario) en vez del icono genérico IconProfiles de RotoBrand.xaml,
        pintado como Background de la insignia circular (RotoPageBadge recorta el Background a su
        CornerRadius al renderizar, igual que en ExportadorPage).
    -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Style="{StaticResource RotoPageBadge}" Margin="0,0,16,0">
                <Border.Background>
                    <ImageBrush ImageSource="/Assets/export_winperfil.png" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <TextBlock x:Name="TxtTitulo" Style="{StaticResource RotoPageTitle}" Margin="0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Antes cmb_Perfil/cmb_PerfilAlu/cmb_Sistema/cmb_Color + btn_FiltrarPerfil/btn_FiltrarPerfilAlu -->
        <Border Grid.Row="1" Style="{StaticResource RotoCard}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="LblProfile" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                           Foreground="{StaticResource RotoInkBrush}" />
                <ComboBox x:Name="CmbPerfil" Grid.Row="0" Grid.Column="1" Style="{StaticResource RotoComboFilter}"
                          Margin="0,0,8,10" DisplayMemberPath="Valor" />
                <Button x:Name="BtnFiltrarPerfil" Grid.Row="0" Grid.Column="2" Style="{StaticResource RotoCardIconButton}"
                        Margin="0,0,0,10" Click="BtnFiltrarPerfil_Click">
                    <Path Data="{StaticResource IconSliders}" Fill="{StaticResource RotoInkBrush}" Width="12" Height="12" Stretch="Uniform" />
                </Button>

                <TextBlock x:Name="LblProfileAlu" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                           Foreground="{StaticResource RotoInkBrush}" Text="Perfil ALU" />
                <ComboBox x:Name="CmbPerfilAlu" Grid.Row="1" Grid.Column="1" Style="{StaticResource RotoComboFilter}"
                          Margin="0,0,8,10" DisplayMemberPath="Valor" />
                <Button x:Name="BtnFiltrarPerfilAlu" Grid.Row="1" Grid.Column="2" Style="{StaticResource RotoCardIconButton}"
                        Margin="0,0,0,10" Click="BtnFiltrarPerfilAlu_Click">
                    <Path Data="{StaticResource IconSliders}" Fill="{StaticResource RotoInkBrush}" Width="12" Height="12" Stretch="Uniform" />
                </Button>

                <TextBlock x:Name="LblSystem" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                           Foreground="{StaticResource RotoInkBrush}" />
                <ComboBox x:Name="CmbSistema" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                          Style="{StaticResource RotoComboFilter}" Margin="0,0,0,10" DisplayMemberPath="Valor" />

                <TextBlock x:Name="LblColour" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"
                           Foreground="{StaticResource RotoInkBrush}" />
                <ComboBox x:Name="CmbColor" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                          Style="{StaticResource RotoComboFilter}" DisplayMemberPath="Name" />
            </Grid>
        </Border>

        <!-- Antes chk_All/txt_filter/lbl_Busqueda + chkList_Sets -->
        <Border Grid.Row="2" Style="{StaticResource RotoCard}" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                    <CheckBox x:Name="ChkAll" DockPanel.Dock="Left" VerticalAlignment="Center"
                              Checked="ChkAll_CheckedChanged" Unchecked="ChkAll_CheckedChanged" Margin="0,0,20,0" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="LblBusqueda" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource RotoInkBrush}" />
                        <TextBox x:Name="TxtFilter" Style="{StaticResource RotoTextBox}" Width="200"
                                 TextChanged="TxtFilter_TextChanged" />
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1" CornerRadius="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                        <ItemsControl x:Name="ListaSets" HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Seleccionado, Mode=TwoWay}"
                                              VerticalContentAlignment="Center" HorizontalAlignment="Stretch"
                                              Padding="6,7" Margin="4,1">
                                        <TextBlock Text="{Binding Codigo}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- Pie: antes btn_ExportSets (solo icono) + progress_Export -->
        <StackPanel Grid.Row="3">
            <ProgressBar x:Name="ProgressExport" Height="8" Margin="0,0,0,12" Visibility="Collapsed"
                         IsIndeterminate="True" Foreground="{StaticResource RotoRedBrush}"
                         Background="{StaticResource RotoBorderBrush}" BorderThickness="0" />
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="LblOpciones" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="{StaticResource RotoGrayBrush}" FontSize="12" />
                <Button x:Name="BtnExportSets" DockPanel.Dock="Right" Style="{StaticResource RotoButtonPrimary}"
                        Click="BtnExportSets_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconDocument}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock x:Name="TxtBtnExport" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
