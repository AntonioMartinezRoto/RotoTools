<Window
    x:Class="RotoTools.Suite.Views.ControlCambios.ControlCambiosConfiguracionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Configuración del informe"
    Width="520"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource RotoContentBackgroundBrush}">

    <!--
        Sustituye a ControlCambiosConfiguracion.cs/.Designer.cs (WinForms): mismos 6 interruptores
        generales (Opciones/Colores/FittingGroups/Mecanizados/Fittings/Sets) más los sub-apartados
        de Fittings y Sets, con el mismo comportamiento de habilitar/deshabilitar en cascada
        (GestionChecksFittings/GestionChecksSets) y los mismos 2 botones "..." que abren el filtro
        de elementos comunes (ver ControlCambiosFiltroItemsWindow.xaml).

        SizeToContent="Height" en vez de una altura fija en píxeles: mismo criterio aprendido con
        TariffImporterAddTariffWindow (ver su comentario), para que el contenido nunca quede
        recortado sin tener que calcular a mano cuánto ocupa el título de la ventana.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Background="{StaticResource RotoNavBackgroundBrush}">
            <TextBlock x:Name="TxtTitulo" FontSize="17" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" Margin="24,0" />
        </Border>

        <!-- Cuerpo -->
        <StackPanel Grid.Row="1" Margin="24,20,24,10">

            <!-- Antes chk_ComparaOpciones/chk_CompararColores/chk_CompararFittingGroups/
                 chk_ComparaMecanizados (4 casillas sueltas, sin sub-apartados). -->
            <Border Style="{StaticResource RotoCard}" Margin="0,0,0,14">
                <StackPanel>
                    <CheckBox x:Name="ChkComparaOpciones" Margin="0,0,0,10" />
                    <CheckBox x:Name="ChkCompararColores" Margin="0,0,0,10" />
                    <CheckBox x:Name="ChkCompararFittingGroups" Margin="0,0,0,10" />
                    <CheckBox x:Name="ChkComparaMecanizados" />
                </StackPanel>
            </Border>

            <!-- Antes chk_CompararFittings + pnl_Fittings (sub-panel). -->
            <Border Style="{StaticResource RotoCard}" Margin="0,0,0,14">
                <StackPanel>
                    <CheckBox x:Name="ChkCompararFittings" Checked="ChkCompararFittings_CheckedChanged"
                              Unchecked="ChkCompararFittings_CheckedChanged" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <DockPanel Margin="24,0,0,8" LastChildFill="False">
                        <CheckBox x:Name="ChkFittingsFiltrados" DockPanel.Dock="Left" VerticalAlignment="Center"
                                  Checked="ChkFittingsFiltrados_CheckedChanged" Unchecked="ChkFittingsFiltrados_CheckedChanged" />
                        <Button x:Name="BtnFittingsFiltrados" DockPanel.Dock="Left" Style="{StaticResource RotoCardIconButton}"
                                Margin="10,0,0,0" Click="BtnFittingsFiltrados_Click">
                            <Path Data="{StaticResource IconSliders}" Fill="{StaticResource RotoInkBrush}" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                    </DockPanel>

                    <CheckBox x:Name="ChkFittingsDescripcion" Margin="24,0,0,8" />
                    <CheckBox x:Name="ChkFittingsManufacturer" Margin="24,0,0,8" />
                    <CheckBox x:Name="ChkFittingsLength" Margin="24,0,0,8" />
                    <CheckBox x:Name="ChkFittingsLocation" Margin="24,0,0,8" />
                    <CheckBox x:Name="ChkFittingsArticles" Margin="24,0,0,0" />
                </StackPanel>
            </Border>

            <!-- Antes chk_CompararSets + pnl_Sets (sub-panel). -->
            <Border Style="{StaticResource RotoCard}">
                <StackPanel>
                    <CheckBox x:Name="ChkCompararSets" Checked="ChkCompararSets_CheckedChanged"
                              Unchecked="ChkCompararSets_CheckedChanged" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <DockPanel Margin="24,0,0,8" LastChildFill="False">
                        <CheckBox x:Name="ChkSetsFiltrados" DockPanel.Dock="Left" VerticalAlignment="Center"
                                  Checked="ChkSetsFiltrados_CheckedChanged" Unchecked="ChkSetsFiltrados_CheckedChanged" />
                        <Button x:Name="BtnSetsFiltrados" DockPanel.Dock="Left" Style="{StaticResource RotoCardIconButton}"
                                Margin="10,0,0,0" Click="BtnSetsFiltrados_Click">
                            <Path Data="{StaticResource IconSliders}" Fill="{StaticResource RotoInkBrush}" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                    </DockPanel>

                    <CheckBox x:Name="ChkSetsNumero" Margin="24,0,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Pie -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,10">
                <Button x:Name="BtnGuardar" Style="{StaticResource RotoButtonPrimary}" Click="BtnGuardar_Click">
                    <TextBlock x:Name="TxtBtnGuardar" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
