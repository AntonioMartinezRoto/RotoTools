<Window
    x:Class="RotoTools.Suite.Views.Actualizador.ActualizadorAsociarConstructivosWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="clr-namespace:RotoTools.Suite.Services"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="Asociar Constructivos" Height="960" Width="1400" MinHeight="700" MinWidth="1050"
    WindowStartupLocation="CenterOwner" WindowState="Maximized"
    Background="{StaticResource RotoContentBackgroundBrush}">

    <!--
        Nueva (no existía en el original): asocia uno o varios Escandallos (tabla Escandallos) al
        nodo psr:ConstructiveScript (sección "Escandallos") de cada elemento "hoja" del XML embebido
        (comprimido, tabla Dibujos, columna Buffer) de uno o varios dibujos (ver
        DibujoConstructivosService). A diferencia de "Añadir opciones ROTO" no hay que cargar ningún
        XML ni elegir modo modelo/elemento: aquí siempre se aplica por elemento hoja, porque un
        constructivo es una propiedad de cada hoja. Reutiliza el mismo patrón árbol+grid+buscador+
        seleccionados que ConfiguradorOpcionesAnadirRotoWindow, dos veces (una para elegir
        Escandallos, otra para elegir Dibujos), más un campo de Variables compartido para todos los
        escandallos que se asocien en esta misma operación.
    -->
    <Window.Resources>
        <Style x:Key="RotoGridIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E9E9EC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Árbol de Escandallos (Nivel1..5, campo Codigo): mismo criterio de icono carpeta/
             documento que DibujoTreeNode. -->
        <HierarchicalDataTemplate DataType="{x:Type svc:EscandalloTreeNode}" ItemsSource="{Binding Hijos}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                      Fill="{StaticResource RotoGrayBrush}">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="{StaticResource IconFolderOpen}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsHoja}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource IconDocument}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <TextBlock Text="{Binding Texto}" VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Árbol de Dibujos (Nivel1..5, campo Codigo): idéntico al de
             ConfiguradorOpcionesAnadirRotoWindow. -->
        <HierarchicalDataTemplate DataType="{x:Type svc:DibujoTreeNode}" ItemsSource="{Binding Hijos}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                      Fill="{StaticResource RotoGrayBrush}">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="{StaticResource IconFolderOpen}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsHoja}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource IconDocument}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <TextBlock Text="{Binding Texto}" VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Placeholder: el tooltip real se asigna en CargarTextos() (DynamicResource, no
             ToolTip="literal" directo, porque estos botones viven dentro de un CellTemplate y se
             instancian una vez por fila; un x:Name ahí no sería accesible desde el code-behind). -->
        <sys:String x:Key="TooltipQuitarSeleccionado">Quitar</sys:String>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0.85*" MinHeight="170" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0.85*" MinHeight="170" />
            <RowDefinition Height="8" />
            <RowDefinition Height="1*" MinHeight="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TxtTitulo" Style="{StaticResource RotoPageTitle}" Margin="0,0,0,4" />
            <TextBlock x:Name="TxtSubtitulo" Foreground="{StaticResource RotoGrayBrush}" FontSize="13" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Árbol de carpetas de Escandallos | Todos los Escandallos -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="280" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="2*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="TxtCarpetasEscandallos" Style="{StaticResource RotoSectionTitle}" Margin="0,0,0,10" />
                    <TreeView Grid.Row="1" x:Name="TreeEscandallos" BorderThickness="0"
                              MouseDoubleClick="TreeEscandallos_MouseDoubleClick">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="LblTodosEscandallos" Style="{StaticResource RotoSectionTitle}" Margin="0,0,0,10" />
                    <TextBox Grid.Row="1" x:Name="TxtBuscarEscandallos" Style="{StaticResource RotoTextBox}" Width="220"
                             HorizontalAlignment="Left" Margin="0,0,0,10" TextChanged="TxtBuscarEscandallos_TextChanged" />
                    <DataGrid Grid.Row="2" x:Name="GridEscandallos" Style="{StaticResource RotoDataGrid}" IsReadOnly="True"
                              MouseDoubleClick="GridEscandallos_MouseDoubleClick"
                              SelectionChanged="GridEscandallos_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColEscCodigo" Header="Código" Binding="{Binding Codigo}" Width="170" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColEscDescripcion" Header="Descripción" Binding="{Binding Descripcion}" Width="*" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColEscNivel1" Header="Nivel 1" Binding="{Binding Nivel1}" Width="100" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColEscNivel2" Header="Nivel 2" Binding="{Binding Nivel2}" Width="100" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColEscNivel3" Header="Nivel 3" Binding="{Binding Nivel3}" Width="100" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColEscNivel4" Header="Nivel 4" Binding="{Binding Nivel4}" Width="100" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColEscNivel5" Header="Nivel 5" Binding="{Binding Nivel5}" Width="100" ElementStyle="{StaticResource RotoDataGridCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- Escandallos seleccionados + Variables: un único texto de Variables para todos los
             escandallos que se asocien en esta misma operación (mismo criterio que pidió el
             usuario: "las variables que el usuario escriba", en singular, no una por escandallo). -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="140" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock x:Name="LblEscSeleccionados" DockPanel.Dock="Left" Style="{StaticResource RotoSectionTitle}" VerticalAlignment="Center" />
                    <Button x:Name="BtnLimpiarEscSeleccionados" DockPanel.Dock="Right" Style="{StaticResource RotoButtonSecondary}"
                            HorizontalAlignment="Right" Click="BtnLimpiarEscSeleccionados_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTrash}" Fill="{StaticResource RotoInkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock x:Name="TxtBtnLimpiarEscSeleccionados" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DockPanel>

                <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
                    <TextBlock x:Name="LblVariables" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox x:Name="TxtVariables" DockPanel.Dock="Left" Style="{StaticResource RotoTextBox}" Width="260"
                             VerticalAlignment="Center" Text="L=L1;A=L2;" />
                </DockPanel>

                <DataGrid Grid.Row="2" x:Name="GridEscSeleccionados" Style="{StaticResource RotoDataGrid}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RotoGridIconButton}" Click="BtnQuitarEscSeleccionado_Click" ToolTip="{DynamicResource TooltipQuitarSeleccionado}">
                                        <Path Data="{StaticResource IconClose}" Fill="{StaticResource RotoGrayBrush}" Width="12" Height="12" Stretch="Uniform" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="ColEscSelCodigo" Header="Código" Binding="{Binding Codigo}" Width="220" ElementStyle="{StaticResource RotoDataGridCellText}" />
                        <DataGridTextColumn x:Name="ColEscSelDescripcion" Header="Descripción" Binding="{Binding Descripcion}" Width="*" ElementStyle="{StaticResource RotoDataGridCellText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Árbol de carpetas de Dibujos | Todos los Dibujos (idéntico patrón a
             ConfiguradorOpcionesAnadirRotoWindow) -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="280" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="2*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="TxtCarpetasDibujos" Style="{StaticResource RotoSectionTitle}" Margin="0,0,0,10" />
                    <TreeView Grid.Row="1" x:Name="TreeDibujos" BorderThickness="0"
                              MouseDoubleClick="TreeDibujos_MouseDoubleClick">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="LblTodosDibujos" Style="{StaticResource RotoSectionTitle}" Margin="0,0,0,10" />
                    <TextBox Grid.Row="1" x:Name="TxtBuscarDibujos" Style="{StaticResource RotoTextBox}" Width="220"
                             HorizontalAlignment="Left" Margin="0,0,0,10" TextChanged="TxtBuscarDibujos_TextChanged" />
                    <DataGrid Grid.Row="2" x:Name="GridDibujos" Style="{StaticResource RotoDataGrid}" IsReadOnly="True"
                              MouseDoubleClick="GridDibujos_MouseDoubleClick"
                              SelectionChanged="GridDibujos_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColDibujoCodigo" Header="Código" Binding="{Binding Codigo}" Width="130" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColDibujoDescripcion" Header="Descripción" Binding="{Binding Descripcion}" Width="*" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColDibujoSistema" Header="Sistema" Binding="{Binding Sistema}" Width="140" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColDibujoNivel1" Header="Nivel 1" Binding="{Binding Nivel1}" Width="100" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColDibujoNivel2" Header="Nivel 2" Binding="{Binding Nivel2}" Width="100" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColDibujoNivel3" Header="Nivel 3" Binding="{Binding Nivel3}" Width="100" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColDibujoNivel4" Header="Nivel 4" Binding="{Binding Nivel4}" Width="100" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColDibujoNivel5" Header="Nivel 5" Binding="{Binding Nivel5}" Width="100" ElementStyle="{StaticResource RotoDataGridCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="5" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- Dibujos seleccionados -->
        <Border Grid.Row="6" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock x:Name="LblSeleccionados" DockPanel.Dock="Left" Style="{StaticResource RotoSectionTitle}" VerticalAlignment="Center" />
                    <Button x:Name="BtnLimpiarSeleccionados" DockPanel.Dock="Right" Style="{StaticResource RotoButtonSecondary}"
                            HorizontalAlignment="Right" Click="BtnLimpiarSeleccionados_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTrash}" Fill="{StaticResource RotoInkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock x:Name="TxtBtnLimpiarSeleccionados" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DockPanel>

                <DataGrid Grid.Row="1" x:Name="GridSeleccionados" Style="{StaticResource RotoDataGrid}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RotoGridIconButton}" Click="BtnQuitarSeleccionado_Click" ToolTip="{DynamicResource TooltipQuitarSeleccionado}">
                                        <Path Data="{StaticResource IconClose}" Fill="{StaticResource RotoGrayBrush}" Width="12" Height="12" Stretch="Uniform" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="ColSelCodigo" Header="Código" Binding="{Binding Codigo}" Width="150" ElementStyle="{StaticResource RotoDataGridCellText}" />
                        <DataGridTextColumn x:Name="ColSelDescripcion" Header="Descripción" Binding="{Binding Descripcion}" Width="*" ElementStyle="{StaticResource RotoDataGridCellText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Progreso: aplicar puede tardar si hay muchos dibujos seleccionados (cada uno hace una
             lectura + escritura en BBDD), así que se muestra una barra de progreso mientras dura. -->
        <Border Grid.Row="7" x:Name="PanelProgreso" Visibility="Collapsed" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="LblProgreso" Margin="0,0,0,6" Foreground="{StaticResource RotoGrayBrush}" FontSize="12.5" />
                <ProgressBar x:Name="BarraProgreso" Height="8" Minimum="0" Maximum="1" Value="0" />
            </StackPanel>
        </Border>

        <!-- Barra inferior -->
        <DockPanel Grid.Row="8" LastChildFill="False">
            <Button x:Name="BtnAplicar" DockPanel.Dock="Left" Style="{StaticResource RotoButtonPrimary}"
                    Click="BtnAplicar_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconPlay}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtBtnAplicar" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="BtnVolver" DockPanel.Dock="Right" Style="{StaticResource RotoButtonSecondary}"
                    Click="BtnVolver_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconBack}" Fill="{StaticResource RotoInkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtBtnVolver" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</Window>
