<Window
    x:Class="RotoTools.Suite.Views.Cam.Cam3DWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cam="clr-namespace:RotoTools.Suite.Views.Cam"
    Title="Cam3D" Height="900" Width="1500" MinHeight="640" MinWidth="1000"
    WindowStartupLocation="CenterOwner" WindowState="Maximized"
    Background="{StaticResource RotoContentBackgroundBrush}">

    <!--
        Sustituye a Cam3D.cs/Cam3D.Designer.cs (WinForms): árbol de materiales + grid de todos
        los perfiles + lista de perfiles a instalar en 3D. Se abre maximizada (en vez del diálogo
        fijo 1850x967 original) porque tiene un TreeView y dos DataGrid grandes, con separadores
        arrastrables entre las distintas zonas para poder aprovechar toda la pantalla.
    -->
    <Window.Resources>
        <cam:NullableDoubleConverter x:Key="NullableDoubleConverter" />

        <Style x:Key="RotoGridIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E9E9EC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icono de carpeta para los nodos de nivel, icono de "perfil" (documento) para las hojas. -->
        <HierarchicalDataTemplate DataType="{x:Type cam:MaterialTreeNode}" ItemsSource="{Binding Hijos}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                      Fill="{StaticResource RotoGrayBrush}">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="{StaticResource IconFolderOpen}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsHoja}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource IconDocument}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <TextBlock Text="{Binding Texto}" VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" MinHeight="180" />
            <RowDefinition Height="8" />
            <RowDefinition Height="1.8*" MinHeight="260" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Operaciones que se instalarán en 3D. Los botones de catálogo/volver se han movido a la
             barra inferior (junto con Instalar) para que queden siempre en la parte de abajo de la
             pantalla y con el mismo tamaño entre ellos. -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="GrpOperacionesInfo" Style="{StaticResource RotoSectionTitle}" Margin="0,0,0,6" />
                <ListBox x:Name="ListaOperacionesInfo" Height="70" Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" />
            </StackPanel>
        </Border>

        <!-- Árbol de materiales | Todos los perfiles: menos alto que la lista de perfiles a
             instalar, que es la que más se consulta/edita. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="320" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="2*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Materiales" Style="{StaticResource RotoSectionTitle}" Margin="0,0,0,10" />
                    <TreeView Grid.Row="1" x:Name="TreeMateriales" BorderThickness="0"
                              MouseDoubleClick="TreeMateriales_MouseDoubleClick">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="LblTodosPerfiles" Style="{StaticResource RotoSectionTitle}" Margin="0,0,0,10" />
                    <TextBox Grid.Row="1" x:Name="TxtBuscar" Style="{StaticResource RotoTextBox}" Width="220"
                             HorizontalAlignment="Left" Margin="0,0,0,10" TextChanged="TxtBuscar_TextChanged" />
                    <DataGrid Grid.Row="2" x:Name="GridMateriales" Style="{StaticResource RotoDataGrid}" IsReadOnly="True"
                              MouseDoubleClick="GridMateriales_MouseDoubleClick"
                              SelectionChanged="GridMateriales_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Referencia" Binding="{Binding ReferenciaBase}" Width="130" ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
                            <DataGridTextColumn Header="Rol" Binding="{Binding Role}" Width="90" ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
                            <DataGridTextColumn Header="Nivel 1" Binding="{Binding Nivel1}" Width="100" ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
                            <DataGridTextColumn Header="Nivel 2" Binding="{Binding Nivel2}" Width="100" ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
                            <DataGridTextColumn Header="Nivel 3" Binding="{Binding Nivel3}" Width="100" ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
                            <DataGridTextColumn Header="Nivel 4" Binding="{Binding Nivel4}" Width="100" ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
                            <DataGridTextColumn Header="Nivel 5" Binding="{Binding Nivel5}" Width="100" ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- Perfiles a instalar: la lista más importante de esta pantalla, se le da más alto que
             al árbol/grid de arriba y ya no tiene un tope máximo de altura. -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock x:Name="LblResultado" DockPanel.Dock="Left" Style="{StaticResource RotoSectionTitle}" VerticalAlignment="Center" />

                    <ComboBox x:Name="CmbFiltroRolResultado" Style="{StaticResource RotoComboFilter}" DockPanel.Dock="Right"
                              Width="160" VerticalAlignment="Center" Margin="0,0,20,0" SelectionChanged="CmbFiltroRolResultado_SelectionChanged" />
                    <TextBlock x:Name="LblFiltroRolResultado" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0" />

                    <Button x:Name="BtnLimpiarResultado" DockPanel.Dock="Right" Style="{StaticResource RotoButtonSecondary}"
                            HorizontalAlignment="Right" Click="BtnLimpiarResultado_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTrash}" Fill="{StaticResource RotoInkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock x:Name="TxtBtnLimpiarResultado" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DockPanel>

                <DataGrid Grid.Row="1" x:Name="GridResultado" Style="{StaticResource RotoDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RotoGridIconButton}" Click="BtnQuitarPerfil_Click" ToolTip="Quitar">
                                        <Path Data="{StaticResource IconClose}" Fill="{StaticResource RotoGrayBrush}" Width="12" Height="12" Stretch="Uniform" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Referencia" Binding="{Binding ReferenciaBase}" Width="120" IsReadOnly="True" ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="1.6*" IsReadOnly="True" ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
                        <DataGridTextColumn Header="Rol" Binding="{Binding Role}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
                        <DataGridTextColumn Header="Ancho int." Binding="{Binding AnchoInterior}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
                        <DataGridTextColumn Header="Ancho ext." Binding="{Binding AnchoExterior}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
                        <DataGridTextColumn Header="Cuerpo int." Binding="{Binding CuerpoInterior}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
                        <DataGridTextColumn Header="Cuerpo ext." Binding="{Binding CuerpoExterior}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
                        <DataGridTextColumn Header="Altura" Binding="{Binding Altura}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
                        <DataGridComboBoxColumn Header="Rol mecanizado" Width="160"
                                                 SelectedItemBinding="{Binding RolMecanizado, Mode=TwoWay}"
                                                 ElementStyle="{StaticResource RotoDataGridCellCombo}"
                                                 x:Name="ColRolMecanizado"
                                                 EditingElementStyle="{StaticResource RotoDataGridCellCombo}" />
                        <DataGridTextColumn Header="Descuento canal herraje" Width="150" ElementStyle="{StaticResource RotoDataGridCellText}"
                                             Binding="{Binding DescuentoCanalHerraje, Converter={StaticResource NullableDoubleConverter}}" />
                        <DataGridTextColumn Header="Posición canal herraje" Width="150" ElementStyle="{StaticResource RotoDataGridCellText}"
                                             Binding="{Binding PosicionCanalHerraje, Converter={StaticResource NullableDoubleConverter}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Barra inferior: instalar / progreso / catálogos / volver / conexión. Los 3 botones de
             navegación (Operaciones, Perfiles, Volver) tienen icono y el mismo tamaño exacto. -->
        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button x:Name="BtnInstalarOperaciones" DockPanel.Dock="Left" Style="{StaticResource RotoButtonPrimary}"
                    Click="BtnInstalarOperaciones_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconPlay}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtBtnInstalar" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <ProgressBar x:Name="ProgressInstalar3D" DockPanel.Dock="Left" Width="260" Height="16" Margin="16,0,0,0"
                         VerticalAlignment="Center" Visibility="Collapsed" />

            <!-- Junto al botón de instalar (antes quedaba solo en la esquina derecha, lejos de
                 todo lo demás de esta barra). -->
            <TextBlock x:Name="TxtConexion" DockPanel.Dock="Left" Foreground="{StaticResource RotoGrayBrush}"
                       FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" />

            <Button x:Name="BtnVolver" DockPanel.Dock="Right" Style="{StaticResource RotoButtonSecondary}"
                    Width="150" Height="42" Margin="8,0,16,0" Click="BtnVolver_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconBack}" Fill="{StaticResource RotoInkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtBtnVolver" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="BtnCatalogoPerfiles" DockPanel.Dock="Right" Style="{StaticResource RotoButtonSecondary}"
                    Width="150" Height="42" Margin="8,0,0,0" Click="BtnCatalogoPerfiles_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconProfiles}" Fill="{StaticResource RotoInkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtBtnCatalogoPerfiles" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="BtnCatalogoOperaciones" DockPanel.Dock="Right" Style="{StaticResource RotoButtonSecondary}"
                    Width="150" Height="42" Margin="0,0,0,0" Click="BtnCatalogoOperaciones_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconOperations}" Fill="{StaticResource RotoInkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtBtnCatalogoOperaciones" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</Window>
