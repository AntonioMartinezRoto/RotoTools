<Window
    x:Class="RotoTools.Suite.Views.ConectorHerraje.ConectorHerrajeActivoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cambiar conector activo" Width="420" MinWidth="420"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource RotoContentBackgroundBrush}">

    <!--
        Nueva (no existía en el original): antes la única forma de cambiar el conector activo
        (VariablesGlobales, fila "Conector Herraje") era de rebote, marcando "Poner como
        predefinido" al generar o combinar un conector (ver ChkPredefinido en
        ConectorHerrajeGeneradorWindow/ConectorHerrajeCombinarWindow). Este diálogo, abierto desde
        la nueva tarjeta "Cambiar conector activo" de ConectorHerrajePage, permite elegir
        directamente cualquiera de los conectores ya guardados en la tabla ConectorHerrajes como
        activo, sin tener que generar ni combinar nada.

        Mismo patrón de diálogo pequeño que TariffImporterAddTariffWindow (SizeToContent="Height"
        + ResizeMode="NoResize", en vez de un Height fijo que no tenga en cuenta la barra de
        título/bordes de la ventana).
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Border Style="{StaticResource RotoPageBadge}" Background="#5E35B1" Margin="0,0,16,0">
                <Path Data="{StaticResource IconRefresh}" Fill="White" Width="20" Height="20" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="TxtTitulo" Style="{StaticResource RotoPageTitle}" Margin="0" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock x:Name="LblConectorActivoActual" Foreground="{StaticResource RotoGrayBrush}" FontSize="12.5" Margin="0,0,0,16" />

            <TextBlock x:Name="LblConector" Foreground="{StaticResource RotoGrayBrush}" FontSize="12" Margin="0,0,0,4" />
            <ComboBox x:Name="CmbConectores" Style="{StaticResource RotoComboFilter}" />
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,20,0,0" LastChildFill="False">
            <Button x:Name="BtnGuardar" DockPanel.Dock="Right" Style="{StaticResource RotoButtonPrimary}"
                    IsDefault="True" Click="BtnGuardar_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconDocument}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtBtnGuardar" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</Window>
