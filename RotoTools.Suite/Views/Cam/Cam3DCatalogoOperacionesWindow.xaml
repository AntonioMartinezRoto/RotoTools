<Window
    x:Class="RotoTools.Suite.Views.Cam.Cam3DCatalogoOperacionesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cam="clr-namespace:RotoTools.Suite.Views.Cam"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="Catálogo de operaciones 3D" Height="900" Width="1500" MinHeight="600" MinWidth="1100"
    WindowStartupLocation="CenterOwner" WindowState="Maximized"
    Background="{StaticResource RotoContentBackgroundBrush}">

    <!--
        Sustituye a Cam3DCatalogoAdmin.cs/.Designer.cs (WinForms): pantalla exclusiva de
        administración del catálogo embebido de plantillas de mecanizado 3D (Resources
        \Mecanizados3D\CatalogoOperaciones3D.json). El original era un diálogo de tamaño fijo
        (1729x1011, no maximizable); aquí se abre maximizada/redimensionable, igual que el resto
        de pantallas de CAM3D, para aprovechar toda la pantalla en las dos grids grandes.
    -->
    <Window.Resources>
        <cam:PlaneArrowConverter x:Key="PlaneArrowConverter" />

        <Style x:Key="RotoGridIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E9E9EC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Placeholders: los tooltips reales se asignan en CargarTextos() (DynamicResource, no
             ToolTip="literal" directo, porque estos botones viven dentro de un CellTemplate y se
             instancian una vez por fila; un x:Name ahí no sería accesible desde el code-behind). -->
        <sys:String x:Key="TooltipDuplicarCatalogo">Duplicar</sys:String>
        <sys:String x:Key="TooltipEliminarCatalogo">Eliminar</sys:String>
        <sys:String x:Key="TooltipCopiarDeCatalogo">Copiar de catálogo</sys:String>
        <sys:String x:Key="TooltipAgregarAlCatalogo">Agregar al catálogo</sys:String>
        <sys:String x:Key="TooltipCopiarTodosLosRoles">Copiar todos los roles</sys:String>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.3*" MinHeight="200" />
            <RowDefinition Height="8" />
            <RowDefinition Height="1*" MinHeight="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TxtTitulo" Style="{StaticResource RotoPageTitle}" Margin="0,0,0,4" />
            <TextBlock x:Name="TxtSubtitulo" Foreground="{StaticResource RotoGrayBrush}" FontSize="13" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Catálogo actual -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                    <TextBlock x:Name="LblCatalogoActual" DockPanel.Dock="Left" Style="{StaticResource RotoSectionTitle}"
                               Margin="0" VerticalAlignment="Center" />

                    <TextBox x:Name="TxtBuscarCatalogo" DockPanel.Dock="Right" Style="{StaticResource RotoTextBox}"
                             Width="220" VerticalAlignment="Center" TextChanged="TxtBuscarCatalogo_TextChanged" />
                    <TextBlock x:Name="LblBuscarCatalogo" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0" />

                    <ComboBox x:Name="CmbFiltroRol" Style="{StaticResource RotoComboFilter}" DockPanel.Dock="Right"
                              Width="160" VerticalAlignment="Center" Margin="0,0,20,0" SelectionChanged="FiltroCatalogo_Changed" />
                    <TextBlock x:Name="LblFiltroRol" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0" />

                    <ComboBox x:Name="CmbFiltroExterior" Style="{StaticResource RotoComboFilter}" DockPanel.Dock="Right"
                              Width="100" VerticalAlignment="Center" Margin="0,0,20,0" SelectionChanged="FiltroCatalogo_Changed" />
                    <TextBlock x:Name="LblFiltroExterior" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                </DockPanel>

                <DataGrid Grid.Row="1" x:Name="GridCatalogo" Style="{StaticResource RotoDataGrid}"
                          LoadingRow="GridCatalogo_LoadingRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColCatOperacion" Header="Operación" Binding="{Binding OperationName}"
                                             Width="*" ElementStyle="{StaticResource RotoDataGridCellText}" />
                        <DataGridComboBoxColumn x:Name="ColCatRol" Header="Rol" Width="150"
                                                 SelectedItemBinding="{Binding Role, Mode=TwoWay}"
                                                 ElementStyle="{StaticResource RotoDataGridCellCombo}"
                                                 EditingElementStyle="{StaticResource RotoDataGridCellCombo}" />
                        <DataGridTextColumn x:Name="ColCatExterior" Header="Exterior" Binding="{Binding Outer}" Width="70"
                                             ElementStyle="{StaticResource RotoDataGridCellText}" />
                        <DataGridTextColumn x:Name="ColCatY" Header="Y" Binding="{Binding YFormula}" Width="220"
                                             ElementStyle="{StaticResource RotoDataGridCellText}" />
                        <DataGridTextColumn x:Name="ColCatZ" Header="Z" Binding="{Binding ZFormula}" Width="220"
                                             ElementStyle="{StaticResource RotoDataGridCellText}" />
                        <DataGridTextColumn x:Name="ColCatPlano" Header="Plano" Binding="{Binding Plane, Converter={StaticResource PlaneArrowConverter}}"
                                             Width="90" ElementStyle="{StaticResource RotoDataGridCellText}" />
                        <DataGridTextColumn x:Name="ColCatProfundidad" Header="Profundidad" Binding="{Binding Depth}" Width="100"
                                             ElementStyle="{StaticResource RotoDataGridCellText}" />
                        <DataGridTemplateColumn Header="" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RotoGridIconButton}" Click="BtnDuplicarCatalogo_Click"
                                            ToolTip="{DynamicResource TooltipDuplicarCatalogo}">
                                        <Path Data="{StaticResource IconDuplicate}" Fill="{StaticResource RotoGrayBrush}"
                                              Width="14" Height="14" Stretch="Uniform" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RotoGridIconButton}" Click="BtnEliminarCatalogo_Click"
                                            ToolTip="{DynamicResource TooltipEliminarCatalogo}">
                                        <Path Data="{StaticResource IconTrash}" Fill="{StaticResource RotoGrayBrush}"
                                              Width="14" Height="14" Stretch="Uniform" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- Operaciones seleccionadas sin definición en el catálogo -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                    <TextBlock x:Name="LblFaltantes" DockPanel.Dock="Left" Style="{StaticResource RotoSectionTitle}"
                               Margin="0" VerticalAlignment="Center" />

                    <TextBox x:Name="TxtBuscarFaltantes" DockPanel.Dock="Right" Style="{StaticResource RotoTextBox}"
                             Width="220" VerticalAlignment="Center" TextChanged="TxtBuscarFaltantes_TextChanged" />
                    <TextBlock x:Name="LblBuscarFaltantes" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0" />

                    <!-- El original permite añadir filas en blanco escribiendo directamente en la
                         última fila vacía de la grid (DataGridView.AllowUserToAddRows); en WPF se
                         sustituye por este botón explícito, más predecible con listas fuertemente
                         tipadas. -->
                    <Button x:Name="BtnAnadirFilaFaltante" DockPanel.Dock="Right" Style="{StaticResource RotoButtonSecondary}"
                            Margin="0,0,20,0" Click="BtnAnadirFilaFaltante_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Fill="{StaticResource RotoInkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock x:Name="TxtBtnAnadirFilaFaltante" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DockPanel>

                <DataGrid Grid.Row="1" x:Name="GridFaltantes" Style="{StaticResource RotoDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColFalOperacion" Header="Operación" Binding="{Binding OperationName}" Width="*"
                                             ElementStyle="{StaticResource RotoDataGridCellText}" />
                        <DataGridComboBoxColumn x:Name="ColFalRol" Header="Rol" Width="150"
                                                 SelectedItemBinding="{Binding Role, Mode=TwoWay}"
                                                 ElementStyle="{StaticResource RotoDataGridCellCombo}"
                                                 EditingElementStyle="{StaticResource RotoDataGridCellCombo}" />
                        <DataGridTextColumn x:Name="ColFalExterior" Header="Exterior" Binding="{Binding Outer}" Width="70"
                                             ElementStyle="{StaticResource RotoDataGridCellText}" />
                        <DataGridTextColumn x:Name="ColFalY" Header="Y" Binding="{Binding YFormula}" Width="220"
                                             ElementStyle="{StaticResource RotoDataGridCellText}" />
                        <DataGridTextColumn x:Name="ColFalZ" Header="Z" Binding="{Binding ZFormula}" Width="220"
                                             ElementStyle="{StaticResource RotoDataGridCellText}" />
                        <DataGridTextColumn x:Name="ColFalPlano" Header="Plano" Binding="{Binding Plane, Converter={StaticResource PlaneArrowConverter}}"
                                             Width="90" ElementStyle="{StaticResource RotoDataGridCellText}" />
                        <DataGridTextColumn x:Name="ColFalProfundidad" Header="Profundidad" Binding="{Binding Depth}" Width="100"
                                             ElementStyle="{StaticResource RotoDataGridCellText}" />
                        <DataGridTemplateColumn Header="" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RotoGridIconButton}" Click="BtnCopiarDeCatalogo_Click"
                                            ToolTip="{DynamicResource TooltipCopiarDeCatalogo}">
                                        <Path Data="{StaticResource IconDownload}" Fill="{StaticResource RotoGrayBrush}"
                                              Width="14" Height="14" Stretch="Uniform" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RotoGridIconButton}" Click="BtnAgregarAlCatalogo_Click"
                                            ToolTip="{DynamicResource TooltipAgregarAlCatalogo}">
                                        <Path Data="{StaticResource IconUpload}" Fill="{StaticResource RotoGrayBrush}"
                                              Width="14" Height="14" Stretch="Uniform" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RotoGridIconButton}" Click="BtnCopiarTodosRoles_Click"
                                            ToolTip="{DynamicResource TooltipCopiarTodosLosRoles}">
                                        <Path Data="{StaticResource IconLink}" Fill="{StaticResource RotoGrayBrush}"
                                              Width="14" Height="14" Stretch="Uniform" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Barra inferior -->
        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button x:Name="BtnGuardar" DockPanel.Dock="Left" Style="{StaticResource RotoButtonPrimary}"
                    Click="BtnGuardar_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconDocument}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtBtnGuardar" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="BtnVolver" DockPanel.Dock="Right" Style="{StaticResource RotoButtonSecondary}"
                    Click="BtnVolver_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconBack}" Fill="{StaticResource RotoInkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtBtnVolver" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</Window>
