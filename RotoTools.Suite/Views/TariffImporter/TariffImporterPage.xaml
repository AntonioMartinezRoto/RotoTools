<UserControl
    x:Class="RotoTools.Suite.Views.TariffImporter.TariffImporterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource RotoContentBackgroundBrush}">

    <!--
        Sustituye a TariffsImporterMenu.cs/.Designer.cs (WinForms): mismo comportamiento y misma
        lógica de negocio (reutilizada tal cual vía RotoTools.Helpers/RotoTools.LocalizationManager
        por ProjectReference, y NPOI para leer el Excel, ya referenciado directamente en
        RotoTools.Suite.csproj). El original era un único formulario fijo (640x339, FixedSingle)
        con un GroupBox "Archivo" (botón de icono + etiqueta de fichero), un GroupBox sin título
        (combo de tarifas + botón "+" para crear una nueva) y un botón "Guardar"; aquí, al no
        crecer el contenido con listas grandes, se mantiene como una única página con 2 tarjetas,
        mismo criterio que ManillasFKSPage.

        El botón de cargar archivo (antes btn_LoadTariff, solo icono sin texto) reutiliza tal cual
        el patrón "botón primario + etiqueta de fichero" ya usado en ConectorHerrajePage
        (BtnLoadXml/LblXml) para cargar el XML de herrajes: mismo DockPanel LastChildFill="False"
        para que la etiqueta se sitúe justo a la derecha del botón en vez de expandirse (ver
        ganancia aprendida en Instalación individualizada de Escandallos: el último hijo de un
        DockPanel ignora su propio Dock salvo que LastChildFill sea False).

        Crear tarifa (antes TariffsImporterAddTariff, un diálogo aparte) sigue siendo una ventana
        modal: ver TariffImporterAddTariffWindow.xaml.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,32">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Border Style="{StaticResource RotoPageBadge}" Background="#0097A7" Margin="0,0,16,0">
                    <Path Data="{StaticResource IconTag}" Fill="White" Width="20" Height="20" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitulo" Style="{StaticResource RotoPageTitle}" Margin="0" />
                    <TextBlock x:Name="TxtSubtitulo" Foreground="{StaticResource RotoGrayBrush}" FontSize="13" />
                </StackPanel>
            </StackPanel>

            <!-- Antes groupBox1 "Archivo" (btn_LoadTariff + lbl_Fichero) -->
            <Border Style="{StaticResource RotoCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="TxtArchivoTitulo" Style="{StaticResource RotoSectionTitle}" />
                    <DockPanel LastChildFill="False">
                        <Button x:Name="BtnLoadTariff" DockPanel.Dock="Left" Style="{StaticResource RotoButtonPrimary}"
                                Click="BtnLoadTariff_Click" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFolderOpen}" Fill="White" Width="16" Height="16" Stretch="Uniform"
                                      Margin="0,0,8,0" />
                                <TextBlock x:Name="TxtBtnLoadTariff" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="LblFichero" DockPanel.Dock="Left" VerticalAlignment="Center"
                                   Foreground="{StaticResource RotoGrayBrush}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Antes groupBox2 sin título (lbl_Tarifa + cmb_Tarifas + btn_AddTariff) -->
            <Border Style="{StaticResource RotoCard}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblTarifa" VerticalAlignment="Center" Foreground="{StaticResource RotoInkBrush}" />
                    <ComboBox x:Name="CmbTarifas" Grid.Column="1" Style="{StaticResource RotoComboFilter}" Margin="0,0,8,0"
                              DisplayMemberPath="Name" SelectedValuePath="RowId" />
                    <Button x:Name="BtnAddTariff" Grid.Column="2" Style="{StaticResource RotoCardIconButton}"
                            Click="BtnAddTariff_Click">
                        <Path Data="{StaticResource IconPlus}" Fill="{StaticResource RotoInkBrush}" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                </Grid>
            </Border>

            <!-- Antes progress_Install (ProgressBar oculta salvo durante ProcesarFilasTarifa) -->
            <ProgressBar x:Name="ProgressInstall" Height="8" Margin="0,0,0,20" Visibility="Collapsed"
                         Foreground="{StaticResource RotoRedBrush}" Background="{StaticResource RotoBorderBrush}"
                         BorderThickness="0" />

            <Button x:Name="BtnImportTariff" Style="{StaticResource RotoButtonPrimary}"
                    HorizontalAlignment="Right" Click="BtnImportTariff_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconDocument}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtBtnImportTariff" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
