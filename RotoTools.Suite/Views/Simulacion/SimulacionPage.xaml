<UserControl
    x:Class="RotoTools.Suite.Views.Simulacion.SimulacionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="clr-namespace:RotoTools.Suite.Services"
    xmlns:local="clr-namespace:RotoTools.Suite.Views.Simulacion"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Background="{StaticResource RotoContentBackgroundBrush}">

    <!--
        Nueva (no existía en el original ni en ningún otro módulo de la Suite): asistente de
        "Depuración de Escandallos" (antes "Simulación", nombre provisional, renombrado a petición
        del usuario) pedido por el usuario para poder recorrer, paso a paso, la cadena real de
        escandallos asociada a una hoja de un Dibujo (el mismo camino que sigue Preference al
        recalcular: RO_CONSTRUCTIVO_HOJA/similar → RO_Gestion Herraje → RO_C_TIPOLOGIAS →
        RO_CONFIGURACION_CLIENTE → los "RO_Herraje*" de personalización de cliente...), preguntando
        el valor de cada opción que haga falta (o usando el valor real ya guardado en el dibujo,
        editable) hasta terminar en un "mapa conceptual" con qué escandallo estableció cada valor.
        Toda la lógica vive en EscandalloInterpreter/EscandalloDsl/SimulacionDatosService (Services):
        esta página solo dirige el asistente paso a paso y presenta los datos.

        Funcionalidad puramente de solo lectura/diagnóstico: no escribe nada en BBDD ni en el XML de
        ningún dibujo.

        Localización ES/EN/PT completa (petición del usuario): todos los textos estáticos pasan por
        SuiteLocalization/L_Suite_* (nuevas claves propias de este módulo, ver CargarTextos en el
        code-behind), salvo los pocos conceptos que ya existían en el original -reutilizan
        RotoTools.LocalizationManager, p.ej. L_Descripcion-. Los dos ToolTip estáticos (icono de
        apertura de cada hoja no incluido, viene de SimulacionDatosService; el aviso "⚠" del mapa
        conceptual sí) usan el patrón habitual de placeholder + DynamicResource, ver más abajo.

        5 pasos, superpuestos en la misma celda de PanelPasos, solo uno visible cada vez (ver
        MostrarPaso): 1) elegir modelo (árbol+grid+buscador, mismo patrón que
        ActualizadorAsociarConstructivosWindow/ConfiguradorOpcionesAnadirRotoWindow), 2) elegir hoja
        (se salta automáticamente si el dibujo solo tiene una), 3) revisar/editar los valores reales
        ya guardados en esa hoja y el escandallo de partida, 4) asistente pregunta-respuesta, 5) mapa
        conceptual final.
    -->

    <UserControl.Resources>
        <!-- Para el aviso "⚠" de opciones sobrescritas en el mapa conceptual (Paso 5). Clase de
             framework estándar de WPF (System.Windows.Controls), no hay que definir nada propio. -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Placeholders para los dos ToolTip/Text estáticos que se traducen vía DynamicResource +
             CargarTextos (mismo patrón que el resto de la Suite ya migrada, ver p.ej.
             ConfiguradorOpcionesAnadirRotoWindow): el " (oculto)" de PlantillaValorPosible y el
             ToolTip del aviso "⚠" de GridMapa (Paso 5). -->
        <sys:String x:Key="TxtSufijoOculto"> (oculto)</sys:String>
        <sys:String x:Key="TooltipValorPisado">Placeholder</sys:String>

        <!-- Para el icono de apertura de cada hoja (Paso 2, ver PlantillaHoja/
             ClaveIconoAperturaConverter en el code-behind). -->
        <local:ClaveIconoAperturaConverter x:Key="ClaveIconoAperturaConverter" />

        <!-- Petición del usuario: el texto gris (RotoGrayBrush) de las líneas secundarias de cada
             hoja (Paso 2) era ILEGIBLE al seleccionar la hoja, porque RotoListItem (RotoBrand.xaml,
             compartido por toda la Suite: no se toca aquí) pinta de rojo el fondo del ListBoxItem
             seleccionado pero estas líneas fijaban su Foreground a RotoGrayBrush de forma explícita,
             así que no heredaban el Foreground=White que ese estilo sí pone en el propio
             ListBoxItem. Este estilo local (solo para esta plantilla, no toca RotoListItem ni
             ningún otro ListBox de la Suite) cambia el Foreground a blanco cuando el ListBoxItem
             contenedor está seleccionado, y lo deja en RotoGrayBrush el resto del tiempo. -->
        <Style x:Key="TextoSecundarioHoja" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource RotoGrayBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Mismo problema que TextoSecundarioHoja de arriba, pero para el Stroke del icono de
             apertura (ver PlantillaHoja): al ir dibujado con trazo (Fill transparente + Stroke, no
             relleno sólido, igual que en ConectorHerrajeGeneradorWindow) no hereda el
             Foreground=White que RotoListItem pone en el ListBoxItem al seleccionarlo, así que
             quedaría con el mismo trazo oscuro (RotoInkBrush) encima del fondo rojo de selección,
             difícil de distinguir. Mismo criterio: oscuro normalmente, blanco cuando la fila está
             seleccionada. -->
        <Style x:Key="IconoAperturaHoja" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource RotoInkBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter Property="Stroke" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Árbol de Dibujos (Nivel1..5, campo Codigo): mismo criterio que
             ActualizadorAsociarConstructivosWindow/ConfiguradorOpcionesAnadirRotoWindow. -->
        <HierarchicalDataTemplate DataType="{x:Type svc:DibujoTreeNode}" ItemsSource="{Binding Hijos}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                      Fill="{StaticResource RotoGrayBrush}">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="{StaticResource IconFolderOpen}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsHoja}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource IconWindowModel}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <TextBlock Text="{Binding Texto}" VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Fila de "hoja" del dibujo (Paso 2). Orden y contenido de estas líneas (además de la
             Etiqueta, que es el título en negrita), sobre la petición explícita original del
             usuario ("en la primera linea el escandallo Constructivo que se llama, en la segunda
             linea el valor de Activa, en la tercera linea la apertura y en la cuarta linea si es
             cota variable, no debe aparecer cuantos valores de opciones hay guardados" -por eso ya
             NO está aquí DescripcionValoresReales, antes sí estaba entre Escandallos y Activa-):
             1) Escandallo Constructivo, 2) Activa, 3) Cota variable -texto, como antes-, MÁS el
             icono de apertura (ver más abajo), que sustituye a lo que antes era la 3ª línea de
             texto ("Apertura: ..."). Petición del usuario: "que no aparezca la linea por hoja en la
             que indica la apertura, ahora aparecerá el dibujo correspondiente a la apertura". -->
        <DataTemplate x:Key="PlantillaHoja" DataType="{x:Type svc:HojaSimulacion}">
            <Grid Margin="2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Etiqueta}" FontWeight="SemiBold" />
                    <!-- 1) Escandallo Constructivo que llama esta hoja. -->
                    <TextBlock Text="{Binding DescripcionEscandallos}" Style="{StaticResource TextoSecundarioHoja}" TextWrapping="Wrap" />
                    <!-- 2) Activa · 3) Cota variable (ver HojaSimulacion.Linea*Detectada en
                         SimulacionDatosService.cs, a partir de psr:Opening; la de Apertura pasó a
                         ser el icono de la derecha, ver más abajo). -->
                    <TextBlock Text="{Binding LineaActivaDetectada}" Style="{StaticResource TextoSecundarioHoja}" FontStyle="Italic"
                               Visibility="{Binding TieneLineaActiva, Converter={StaticResource BoolToVisConverter}}" />
                    <TextBlock Text="{Binding LineaCotaVariableDetectada}" Style="{StaticResource TextoSecundarioHoja}" FontStyle="Italic"
                               Visibility="{Binding TieneLineaCotaVariable, Converter={StaticResource BoolToVisConverter}}" />
                </StackPanel>

                <!-- Dibujo de la apertura: mismas 8 geometrías IconApertura* (Theme/RotoBrand.xaml)
                     y el mismo estilo de trazo (Fill transparente + Stroke, en vez de relleno sólido
                     como el resto de iconos de la Suite) que ya usa la columna "Apertura" de la
                     grid de "Generar conector de herraje" (ver ConectorHerrajeGeneradorWindow.xaml,
                     SetGridRowVm.AperturaIconoGeometria/AperturaIconoFlip) - MISMO lenguaje visual
                     en los dos sitios, aunque el cálculo de cuál mostrar es distinto (ver el
                     comentario de HojaSimulacion.AperturaIconoClave en SimulacionDatosService.cs: el
                     dato de origen no es el mismo). El texto descriptivo completo (antes visible
                     como 3ª línea) se conserva como ToolTip en vez de perderse -mismo criterio que
                     ya aplicó esa misma pantalla al migrar su propia columna "Apertura"-. Sin icono
                     resoluble (AperturaIconoClave nulo, ver su comentario), no se muestra nada aquí:
                     no queda ningún hueco en blanco reservado porque Visibility=Collapsed no ocupa
                     espacio de layout. -->
                <Path Grid.Column="1" Style="{StaticResource IconoAperturaHoja}" Data="{Binding AperturaIconoClave, Converter={StaticResource ClaveIconoAperturaConverter}}"
                      Fill="Transparent" StrokeThickness="1.6"
                      Width="30" Height="30" Stretch="Uniform" Margin="8,0,0,0"
                      HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                      ToolTip="{Binding DescripcionApertura}"
                      Visibility="{Binding TieneIconoApertura, Converter={StaticResource BoolToVisConverter}}">
                    <Path.RenderTransform>
                        <ScaleTransform ScaleX="{Binding AperturaIconoFlip}" />
                    </Path.RenderTransform>
                </Path>
            </Grid>
        </DataTemplate>

        <!-- Fila de "posible valor" al responder una pregunta (Paso 4): Valor + Texto, marcando si
             está oculto en Preference (ver el comentario de EscandalloInterpreter/BtnResponder_Click
             sobre por qué se muestran también los ocultos: un valor necesario pero oculto por error
             es justo el tipo de problema que esta herramienta debe poder localizar). -->
        <DataTemplate x:Key="PlantillaValorPosible" DataType="{x:Type local:FilaValorPosible}">
            <StackPanel Orientation="Horizontal" Margin="2,3">
                <TextBlock Text="{Binding Valor}" FontWeight="SemiBold" />
                <TextBlock Text=" — " Foreground="{StaticResource RotoGrayBrush}" />
                <TextBlock Text="{Binding Texto}" />
                <TextBlock Text="{DynamicResource TxtSufijoOculto}" Foreground="{StaticResource RotoRedBrush}" FontStyle="Italic"
                           Visibility="{Binding VisibilidadEtiquetaOculto}" />
            </StackPanel>
        </DataTemplate>

        <!-- Línea del "Recorrido" (Paso 4, ListLog: _log es una lista de string). Sin esta plantilla,
             el TextBlock que WPF genera por defecto para un string no envuelve el texto (y RotoList
             tiene el scroll horizontal desactivado), así que un mensaje largo -como los nuevos
             mensajes de error de parseo más explicativos, con línea/columna y un fragmento del
             Programa, ver EscandalloDsl.ConstruirMensajeError- quedaría cortado sin poderse leer
             entero. TextWrapping="Wrap" + fuente monoespaciada para que el fragmento de Programa que
             citan esos mensajes (con comillas, paréntesis, etc.) se lea alineado. -->
        <DataTemplate x:Key="PlantillaLineaLog" DataType="{x:Type sys:String}">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12.5" Margin="0,2" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="40,28,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Border Style="{StaticResource RotoPageBadge}" Background="#3949AB" Margin="0,0,16,0">
                <Path Data="{StaticResource IconEye}" Fill="White" Width="20" Height="20" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtTituloPagina" Style="{StaticResource RotoPageTitle}" Margin="0" />
                <TextBlock x:Name="TxtSubtituloPagina" Foreground="{StaticResource RotoGrayBrush}" FontSize="13" />
            </StackPanel>
        </StackPanel>

        <!-- Migas de pan del paso actual -->
        <TextBlock x:Name="TxtPaso" Grid.Row="1" Margin="0,0,0,14" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource RotoInkBrush}" />

        <Grid Grid.Row="2" x:Name="PanelPasos">

            <!-- ===== Paso 1: elegir modelo ===== -->
            <Grid x:Name="PanelPaso1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Petición del usuario: elegir el modelo desde un Dibujo YA guardado en BBDD
                     (como hasta ahora) o desde una línea de un Presupuesto (tabla ContenidoPAFBlob,
                     ver PresupuestoDatosService/DibujoImagenService.CargarVistaPreviaPresupuesto/
                     SimulacionDatosService.ObtenerHojasDesdePresupuesto). Los dos sub-paneles de
                     abajo (PanelPaso1BaseDatos/PanelPaso1Presupuesto) están superpuestos en la misma
                     celda -mismo patrón que PanelPasos en el Grid raíz-, mostrando solo uno cada vez
                     (ver RbOrigenModelo_Changed en el code-behind). -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                    <RadioButton x:Name="RbOrigenBaseDatos" GroupName="OrigenModeloPaso1"
                                 IsChecked="True" VerticalAlignment="Center" Margin="0,0,24,0"
                                 Checked="RbOrigenModelo_Changed" />
                    <RadioButton x:Name="RbOrigenPresupuesto" GroupName="OrigenModeloPaso1"
                                 VerticalAlignment="Center" Checked="RbOrigenModelo_Changed" />
                </StackPanel>

                <Grid Grid.Row="1">

                    <!-- Modo "Base de datos": árbol+grid+buscador, igual que antes -->
                    <Grid x:Name="PanelPaso1BaseDatos">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" MinWidth="260" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="2*" MinWidth="380" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" x:Name="TxtCarpetasPaso1" Style="{StaticResource RotoSectionTitle}" Margin="0,0,0,10" />
                                <TreeView Grid.Row="1" x:Name="TreeDibujos" BorderThickness="0"
                                          MouseDoubleClick="TreeDibujos_MouseDoubleClick">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                </TreeView>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

                        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" x:Name="TxtElegirModeloDobleClic" Style="{StaticResource RotoSectionTitle}" Margin="0,0,0,10" />
                                <TextBox Grid.Row="1" x:Name="TxtBuscarDibujos" Style="{StaticResource RotoTextBox}" Width="260"
                                         HorizontalAlignment="Left" Margin="0,0,0,10" TextChanged="TxtBuscarDibujos_TextChanged" />
                                <!-- Petición del usuario: la grid solo mostraba Nivel 1 y Nivel 2, pero un
                                     dibujo puede tener hasta 5 niveles de carpeta (ver DibujoRow/el árbol
                                     de la izquierda, que sí usa los 5). Se añaden las 3 columnas que
                                     faltaban y se estrechan Código/Sistema/Nivel* -antes más anchas de lo
                                     que su contenido necesita- para que quepan más columnas a la vez.
                                     RotoDataGrid (Theme/RotoBrand.xaml, compartido por toda la Suite: no
                                     se toca ahí) deja HorizontalScrollBarVisibility="Disabled" por
                                     defecto; aquí se sobreescribe a "Auto" SOLO en esta instancia -un
                                     valor puesto directamente en el elemento gana siempre al Setter del
                                     Style- para que, si aun así no cupiera todo (ventana estrecha, dibujo
                                     con carpetas muy profundas), aparezca una barra de scroll horizontal
                                     en vez de recortar columnas sin poder verlas. -->
                                <DataGrid Grid.Row="2" x:Name="GridDibujos" Style="{StaticResource RotoDataGrid}" IsReadOnly="True"
                                          HorizontalScrollBarVisibility="Auto"
                                          MouseDoubleClick="GridDibujos_MouseDoubleClick"
                                          SelectionChanged="GridDibujos_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="ColDibujoCodigo" Binding="{Binding Codigo}" Width="110" ElementStyle="{StaticResource RotoDataGridCellText}" />
                                        <DataGridTextColumn x:Name="ColDibujoDescripcion" Binding="{Binding Descripcion}" Width="*" MinWidth="150" ElementStyle="{StaticResource RotoDataGridCellText}" />
                                        <DataGridTextColumn x:Name="ColDibujoSistema" Binding="{Binding Sistema}" Width="95" ElementStyle="{StaticResource RotoDataGridCellText}" />
                                        <DataGridTextColumn x:Name="ColDibujoNivel1" Binding="{Binding Nivel1}" Width="80" ElementStyle="{StaticResource RotoDataGridCellText}" />
                                        <DataGridTextColumn x:Name="ColDibujoNivel2" Binding="{Binding Nivel2}" Width="80" ElementStyle="{StaticResource RotoDataGridCellText}" />
                                        <DataGridTextColumn x:Name="ColDibujoNivel3" Binding="{Binding Nivel3}" Width="80" ElementStyle="{StaticResource RotoDataGridCellText}" />
                                        <DataGridTextColumn x:Name="ColDibujoNivel4" Binding="{Binding Nivel4}" Width="80" ElementStyle="{StaticResource RotoDataGridCellText}" />
                                        <DataGridTextColumn x:Name="ColDibujoNivel5" Binding="{Binding Nivel5}" Width="80" ElementStyle="{StaticResource RotoDataGridCellText}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Grid.Row="3" x:Name="TxtErrorPaso1" Foreground="{StaticResource RotoRedBrush}" Margin="0,10,0,0"
                                           TextWrapping="Wrap" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Modo "Presupuesto": Número/Versión/Orden en cascada (ContenidoPAFBlob)
                         + panel de previsualización PROPIO con sus propios controles de zoom
                         (petición explícita del usuario tras la pregunta aclaratoria: "Panel de
                         previsualización propio dentro del Paso 1", duplicado del de Paso 2 en vez
                         de reutilizar ese -que solo aparece una vez elegido el modelo-). Al pulsar
                         "Continuar" se pasa al Paso 2, que a partir de ahí sigue el MISMO camino
                         común que el modo Base de datos (ver IniciarPaso2ConHojas/
                         CargarVistaPreviaDibujo en el code-behind: los dos ya despachan según
                         _origenModelo). -->
                    <Grid x:Name="PanelPaso1Presupuesto" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock x:Name="TxtElegirPresupuesto" Style="{StaticResource RotoSectionTitle}" Margin="0,0,0,14" />

                                    <TextBlock x:Name="TxtEtiquetaNumero" Foreground="{StaticResource RotoGrayBrush}" FontSize="12" Margin="0,0,0,4" />
                                    <ComboBox x:Name="CmbPresupuestoNumero" Style="{StaticResource RotoComboFilter}"
                                              SelectionChanged="CmbPresupuestoNumero_SelectionChanged" />

                                    <TextBlock x:Name="TxtEtiquetaVersion" Foreground="{StaticResource RotoGrayBrush}" FontSize="12" Margin="0,14,0,4" />
                                    <ComboBox x:Name="CmbPresupuestoVersion" Style="{StaticResource RotoComboFilter}" IsEnabled="False"
                                              SelectionChanged="CmbPresupuestoVersion_SelectionChanged" />

                                    <TextBlock x:Name="TxtEtiquetaOrdenLinea" Foreground="{StaticResource RotoGrayBrush}" FontSize="12" Margin="0,14,0,4" />
                                    <!-- ItemsSource son FilaOrdenPresupuesto, no string (a diferencia de
                                         CmbPresupuestoNumero/Version): petición del usuario, ver su
                                         comentario de clase en el code-behind -Orden es base CERO en
                                         BBDD pero se muestra en base UNO-. DisplayMemberPath="Etiqueta"
                                         para que el desplegable cerrado también muestre la etiqueta
                                         (base uno) y no el ToString() por defecto del objeto. -->
                                    <ComboBox x:Name="CmbPresupuestoOrden" Style="{StaticResource RotoComboFilter}" IsEnabled="False"
                                              DisplayMemberPath="Etiqueta"
                                              SelectionChanged="CmbPresupuestoOrden_SelectionChanged" />

                                    <TextBlock x:Name="TxtErrorPaso1Presupuesto" Foreground="{StaticResource RotoRedBrush}" Margin="0,16,0,0"
                                               TextWrapping="Wrap" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

                            <!-- Mismo patrón EXACTO que la vista previa del Paso 2 (Image+ScaleTransform
                                 dentro de un ScrollViewer, zoom con botones -/+/Ajustar y rueda del
                                 ratón): ver el comentario de esa Border en el Paso 2 para el porqué de
                                 cada pieza. Nombres de elemento distintos (sufijo "Presupuesto") porque
                                 es un panel de UI totalmente aparte -zoom independiente del de Paso 2,
                                 ver _zoomPresupuesto en el code-behind-. -->
                            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <ScrollViewer x:Name="ScrollVistaPreviaPresupuesto" Grid.Row="0" Padding="14"
                                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                                  PreviewMouseWheel="ScrollVistaPreviaPresupuesto_PreviewMouseWheel">
                                        <Grid>
                                            <Image x:Name="ImgVistaPreviaPresupuesto" Visibility="Collapsed"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.LayoutTransform>
                                                    <ScaleTransform x:Name="TransformZoomPresupuesto" ScaleX="1" ScaleY="1" />
                                                </Image.LayoutTransform>
                                            </Image>
                                            <TextBlock x:Name="TxtVistaPreviaPresupuestoAviso"
                                                       Foreground="{StaticResource RotoGrayBrush}" TextWrapping="Wrap"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                                       MaxWidth="320" />
                                        </Grid>
                                    </ScrollViewer>

                                    <DockPanel Grid.Row="1" LastChildFill="False" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <Button x:Name="BtnZoomPresupuestoMenos" DockPanel.Dock="Left" Style="{StaticResource RotoButtonSecondary}"
                                                Content="−" Width="34" Click="BtnZoomPresupuestoMenos_Click" />
                                        <TextBlock x:Name="TxtZoomPresupuestoPorcentaje" DockPanel.Dock="Left" Text="100%" VerticalAlignment="Center"
                                                   Margin="8,0" MinWidth="46" TextAlignment="Center" />
                                        <Button x:Name="BtnZoomPresupuestoMas" DockPanel.Dock="Left" Style="{StaticResource RotoButtonSecondary}"
                                                Content="+" Width="34" Click="BtnZoomPresupuestoMas_Click" />
                                        <Button x:Name="BtnZoomPresupuestoAjustar" DockPanel.Dock="Left" Style="{StaticResource RotoButtonSecondary}"
                                                Margin="10,0,0,0" Click="BtnZoomPresupuestoAjustar_Click" />
                                        <TextBlock x:Name="TxtVistaPreviaPresupuestoFuente" DockPanel.Dock="Left" VerticalAlignment="Center"
                                                   Margin="16,0,0,0" FontSize="11" Foreground="{StaticResource RotoGrayBrush}"
                                                   Visibility="Collapsed" />
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <DockPanel Grid.Row="1" Margin="0,14,0,0" LastChildFill="False">
                            <Button x:Name="BtnPaso1PresupuestoContinuar" DockPanel.Dock="Right" Style="{StaticResource RotoButtonPrimary}"
                                    IsEnabled="False" Click="BtnPaso1PresupuestoContinuar_Click" />
                        </DockPanel>
                    </Grid>

                </Grid>
            </Grid>

            <!-- ===== Paso 2: elegir hoja (solo si el dibujo tiene más de una) ===== -->
            <Grid x:Name="PanelPaso2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="TxtTituloPaso2" Style="{StaticResource RotoSectionTitle}" Margin="0,0,0,10" TextWrapping="Wrap" />
                            <ListBox Grid.Row="1" x:Name="ListHojas" Style="{StaticResource RotoList}"
                                     ItemTemplate="{StaticResource PlantillaHoja}"
                                     SelectionChanged="ListHojas_SelectionChanged" />
                        </Grid>
                    </Border>

                    <!-- Vista previa del dibujo del modelo (petición del usuario): se carga una vez,
                         al elegir el dibujo (ver CargarVistaPreviaDibujo), no por cada hoja -es la
                         misma imagen para todas las hojas del mismo dibujo-. TxtVistaPreviaAviso
                         cubre tanto "cargando..." como "no se ha podido generar" sin más estado que
                         alternar su Visibility con la de la propia Image.

                         Zoom: ImgVistaPreviaDibujo se muestra a su tamaño NATIVO en píxeles (Width/
                         Height puestos a mano al cargar la imagen, ver CargarVistaPreviaDibujo) con
                         un ScaleTransform (TransformZoomDibujo) encima -el patrón habitual en WPF
                         para un visor con zoom, más fiable aquí que Stretch=Uniform, que dentro de
                         un ScrollViewer (espacio "infinito") no tiene ningún tamaño al que ajustarse
                         y por eso la imagen se veía diminuta-. AjustarZoomDibujoAVentana calcula el
                         zoom inicial ("Ajustar") para que quepa entera; los botones -/+ y la rueda
                         del ratón sobre la imagen (ScrollVistaPreviaDibujo_PreviewMouseWheel) lo
                         cambian; el propio ScrollViewer con barras "Auto" permite desplazarse
                         cuando el zoom hace que la imagen no quepa entera. -->
                    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer x:Name="ScrollVistaPreviaDibujo" Grid.Row="0" Padding="14"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                          PreviewMouseWheel="ScrollVistaPreviaDibujo_PreviewMouseWheel">
                                <Grid>
                                    <Image x:Name="ImgVistaPreviaDibujo" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.LayoutTransform>
                                            <ScaleTransform x:Name="TransformZoomDibujo" ScaleX="1" ScaleY="1" />
                                        </Image.LayoutTransform>
                                    </Image>
                                    <TextBlock x:Name="TxtVistaPreviaAviso"
                                               Foreground="{StaticResource RotoGrayBrush}" TextWrapping="Wrap"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                               MaxWidth="320" />
                                </Grid>
                            </ScrollViewer>

                            <DockPanel Grid.Row="1" LastChildFill="False" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Button x:Name="BtnZoomMenos" DockPanel.Dock="Left" Style="{StaticResource RotoButtonSecondary}"
                                        Content="−" Width="34" Click="BtnZoomMenos_Click" />
                                <TextBlock x:Name="TxtZoomPorcentaje" DockPanel.Dock="Left" Text="100%" VerticalAlignment="Center"
                                           Margin="8,0" MinWidth="46" TextAlignment="Center" />
                                <Button x:Name="BtnZoomMas" DockPanel.Dock="Left" Style="{StaticResource RotoButtonSecondary}"
                                        Content="+" Width="34" Click="BtnZoomMas_Click" />
                                <Button x:Name="BtnZoomAjustar" DockPanel.Dock="Left" Style="{StaticResource RotoButtonSecondary}"
                                        Margin="10,0,0,0" Click="BtnZoomAjustar_Click" />
                                <!-- Puramente informativo: de qué columna (Thumbnail/Metafile) salió la
                                     imagen -DibujoImagenService.ImagenDibujo.Fuente-, para no tener que
                                     adivinarlo mirando el resultado en pantalla. -->
                                <TextBlock x:Name="TxtVistaPreviaFuente" DockPanel.Dock="Left" VerticalAlignment="Center"
                                           Margin="16,0,0,0" FontSize="11" Foreground="{StaticResource RotoGrayBrush}"
                                           Visibility="Collapsed" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>

                <DockPanel Grid.Row="1" Margin="0,14,0,0" LastChildFill="False">
                    <Button x:Name="BtnPaso2Atras" DockPanel.Dock="Left" Style="{StaticResource RotoButtonSecondary}" Click="BtnPaso2Atras_Click" />
                    <Button x:Name="BtnPaso2Continuar" DockPanel.Dock="Left" Style="{StaticResource RotoButtonPrimary}"
                            IsEnabled="False" Click="BtnPaso2Continuar_Click" />
                </DockPanel>
            </Grid>

            <!-- ===== Paso 3: valores reales precargados (editables) + escandallo de partida ===== -->
            <Grid x:Name="PanelPaso3" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="TxtTituloEscandalloInicial" Style="{StaticResource RotoSectionTitle}" Margin="0,0,0,6" />
                        <TextBox x:Name="TxtEscandalloInicial" Style="{StaticResource RotoTextBox}" Width="320" HorizontalAlignment="Left" />
                        <TextBlock x:Name="TxtOtrosEscandallos" Foreground="{StaticResource RotoGrayBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Petición del usuario: mismo criterio que el mapa conceptual del Paso 5
                             -solo opciones reales de catálogo ROTO (Nombre empieza por "RO_")-, pero
                             aquí SÍ con un check para desbloquearlo (a diferencia del filtro RO_ del
                             Paso 5, que es fijo): ver AplicarFiltroValoresReales/
                             ChkMostrarOtrasOpcionesReales_Changed. El filtro es solo de PRESENTACIÓN
                             -_valoresReales (la lista completa, sin filtrar) es la que de verdad se
                             precarga en el intérprete al pulsar "Iniciar simulación", así que un
                             valor real oculto aquí por el filtro se sigue aplicando igual-. -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="TxtValoresRealesDescripcion" Style="{StaticResource RotoSectionTitle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" x:Name="ChkMostrarOtrasOpcionesReales" VerticalAlignment="Center" Margin="10,0,0,0"
                                      Checked="ChkMostrarOtrasOpcionesReales_Changed" Unchecked="ChkMostrarOtrasOpcionesReales_Changed" />
                        </Grid>
                        <DataGrid Grid.Row="1" x:Name="GridValoresReales" Style="{StaticResource RotoDataGrid}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ColValorRealOpcion" Binding="{Binding Nombre}" Width="180" IsReadOnly="True" ElementStyle="{StaticResource RotoDataGridCellText}" />
                                <DataGridTextColumn x:Name="ColValorRealValor" Binding="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                     ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
                                <DataGridTextColumn x:Name="ColValorRealOrigen" Binding="{Binding Origen}" Width="280" IsReadOnly="True" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
                    <Button x:Name="BtnPaso3Atras" DockPanel.Dock="Left" Style="{StaticResource RotoButtonSecondary}" Click="BtnPaso3Atras_Click" />
                    <Button x:Name="BtnIniciarSimulacion" DockPanel.Dock="Left" Style="{StaticResource RotoButtonPrimary}" Click="BtnIniciarSimulacion_Click" />
                </DockPanel>
            </Grid>

            <!-- ===== Paso 4: asistente pregunta-respuesta ===== -->
            <Grid x:Name="PanelPaso4" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" MinWidth="320" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <!-- Registro en vivo del recorrido (auto-consumido: entra/sale de escandallos,
                     ESTABLECEOPCION, avisos...). -->
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="TxtTituloRecorrido" Style="{StaticResource RotoSectionTitle}" Margin="0,0,0,8" />
                        <ListBox Grid.Row="1" x:Name="ListLog" Style="{StaticResource RotoList}" BorderThickness="0"
                                 ScrollViewer.CanContentScroll="False" ItemTemplate="{StaticResource PlantillaLineaLog}" />
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- Pregunta actual: única parada del asistente. -->
                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="TxtTituloPregunta" Style="{StaticResource RotoSectionTitle}" Margin="0,0,0,4" />
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBlock x:Name="TxtPreguntaOpcion" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="TxtPreguntaEscandallo" Foreground="{StaticResource RotoGrayBrush}" FontSize="12.5" TextWrapping="Wrap" />
                        </StackPanel>
                        <ListBox Grid.Row="2" x:Name="ListValoresPosibles" Style="{StaticResource RotoList}"
                                 ItemTemplate="{StaticResource PlantillaValorPosible}" />
                        <StackPanel Grid.Row="3" x:Name="PanelRespuestaPregunta" Margin="0,10,0,0">
                            <Button x:Name="BtnResponder" Style="{StaticResource RotoButtonPrimary}"
                                    HorizontalAlignment="Stretch" Click="BtnResponder_Click" />
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock x:Name="TxtOtroValor" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left" />
                                <Button x:Name="BtnResponderLibre" DockPanel.Dock="Right" Style="{StaticResource RotoButtonSecondary}"
                                        Margin="8,0,0,0" Click="BtnResponderLibre_Click" />
                                <TextBox x:Name="TxtValorLibre" Style="{StaticResource RotoTextBox}" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0" LastChildFill="False">
                    <Button x:Name="BtnReiniciarPaso4" DockPanel.Dock="Left" Style="{StaticResource RotoButtonSecondary}" Click="BtnReiniciar_Click" />
                    <!-- Petición del usuario: al terminar todas las preguntas ya NO se pasa solo al
                         Paso 5 -antes sí, ver MostrarSimulacionTerminada/AvanzarSimulacion en el
                         code-behind-, para poder revisar antes el "Recorrido" de la izquierda (p.ej.
                         localizar desde dónde se estableció una opción como CotaVariable fuera de
                         los escandallos de ROTO, algo que el mapa conceptual del Paso 5 no puede
                         explicar por sí solo porque solo lista el resultado final). Deshabilitado
                         hasta que la simulación realmente termine (BtnIniciarSimulacion_Click lo dis-
                         habilita al arrancar; MostrarSimulacionTerminada lo habilita al llegar a Fin). -->
                    <Button x:Name="BtnVerMapaConceptual" DockPanel.Dock="Right" Style="{StaticResource RotoButtonPrimary}"
                            IsEnabled="False" Click="BtnVerMapaConceptual_Click" />
                </DockPanel>
            </Grid>

            <!-- ===== Paso 5: mapa conceptual final ===== -->
            <Grid x:Name="PanelPaso5" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                    <TextBlock x:Name="TxtTituloMapaConceptual" Style="{StaticResource RotoSectionTitle}" Margin="0" DockPanel.Dock="Left" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtBuscarMapa" Style="{StaticResource RotoTextBox}" Width="280" DockPanel.Dock="Right"
                             TextChanged="TxtBuscarMapa_TextChanged" />
                    <CheckBox x:Name="ChkMostrarOcultos" DockPanel.Dock="Right"
                              VerticalAlignment="Center" Margin="0,0,16,0"
                              Checked="ChkMostrarOcultos_Changed" Unchecked="ChkMostrarOcultos_Changed" />
                </DockPanel>

                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14">
                    <DataGrid x:Name="GridMapa" Style="{StaticResource RotoDataGrid}" IsReadOnly="True"
                              AutoGenerateColumns="False" RowHeight="NaN">
                        <DataGrid.RowStyle>
                            <!-- Sin BasedOn: RotoDataGrid (Theme/RotoBrand.xaml) no define ningún RowStyle
                                 ni ningún estilo implícito TargetType="DataGridRow" del que partir -usar
                                 BasedOn="{StaticResource {x:Type DataGridRow}}" aquí fallaría al cargar el
                                 XAML por no encontrar ese recurso, igual que pasó con RowHeight="Auto"-.
                                 El fondo de alternancia de filas (RowBackground/AlternatingRowBackground,
                                 puestos por el propio Style "RotoDataGrid") no depende de RowStyle y se
                                 sigue aplicando con normalidad; aquí solo se añaden los dos triggers de
                                 abajo encima de ese comportamiento por defecto. -->
                            <Style TargetType="DataGridRow">
                                <!-- Resalta visualmente las opciones "pisadas" más de una vez: es justo el
                                     tipo de caso que este mapa conceptual existe para localizar. -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Sobrescrita}" Value="True">
                                        <Setter Property="Background" Value="#FFF6E0B0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Oculto}" Value="True">
                                        <Setter Property="Opacity" Value="0.65" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColMapaOpcion" Binding="{Binding Nombre}" Width="220" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColMapaValorFinal" Binding="{Binding ValorFinal}" Width="160" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColMapaOrigenFinal" Binding="{Binding OrigenFinal}" Width="180" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTemplateColumn Header="⚠" Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="⚠" ToolTip="{DynamicResource TooltipValorPisado}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding Sobrescrita, Converter={StaticResource BoolToVisConverter}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="ColMapaHistorial" Binding="{Binding HistorialTexto}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="Margin" Value="0,6" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
                    <Button x:Name="BtnNuevaSimulacion" DockPanel.Dock="Left" Style="{StaticResource RotoButtonSecondary}" Click="BtnReiniciar_Click" />
                    <!-- Petición del usuario: poder volver al Paso 4 desde el mapa conceptual para
                         revisar el "Recorrido" cuando quiera, no solo antes de pulsar "Ver mapa
                         conceptual final" la primera vez. No hace falta rehacer nada al volver: el
                         propio intérprete/enumerador/log no se tocan al mostrar el Paso 5 (ver
                         MostrarMapaConceptual en el code-behind), así que el Paso 4 se ve exactamente
                         como se dejó -incluido el aviso "Simulación terminada" y el botón "Ver mapa
                         conceptual final" ya habilitado, para poder volver aquí de nuevo sin más-. -->
                    <Button x:Name="BtnPaso5Atras" DockPanel.Dock="Left" Style="{StaticResource RotoButtonSecondary}"
                            Margin="10,0,0,0" Click="BtnPaso5Atras_Click" />
                </DockPanel>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
