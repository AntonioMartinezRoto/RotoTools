<Window
    x:Class="RotoTools.Suite.Views.ConectorHerraje.ConectorHerrajeCombinarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Combinar conectores" Height="680" Width="920" MinHeight="560" MinWidth="820"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource RotoContentBackgroundBrush}">

    <!--
        Sustituye a ConectorHerrajeCombinar.cs/.Designer.cs (WinForms): combina varios conectores
        de herraje ya guardados en BBDD, bien creando uno nuevo o insertándolos en uno existente.
        El original era un diálogo fijo (765x400, no maximizable); aquí se mantiene un tamaño
        moderado (no maximizado) porque, a diferencia de las otras pantallas de esta suite, su
        contenido no crece con listas grandes.

        Pequeña mejora deliberada sobre el original: al recargar la lista de "Conectores en la
        base de datos" también se excluyen los que ya están en "Conectores a combinar" (el
        original solo excluía el conector objetivo del combo, así que si se cambiaba de conector
        objetivo tras haber movido alguno a la lista de combinar, podía duplicarse en ambas
        listas).
    -->
    <Window.Resources>
        <Style x:Key="BtnTransferencia" TargetType="Button" BasedOn="{StaticResource RotoButtonSecondary}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Style="{StaticResource RotoPageBadge}" Background="#00838F" Margin="0,0,16,0">
                <Path Data="{StaticResource IconLink}" Fill="White" Width="20" Height="20" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="TxtTitulo" Style="{StaticResource RotoPageTitle}" Margin="0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Modo: crear nuevo / insertar en existente -->
        <UniformGrid Grid.Row="1" Columns="2" Rows="1" Margin="0,0,0,14">
            <Border Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="0,0,7,0">
                <StackPanel>
                    <RadioButton x:Name="RbNuevoConector" GroupName="ModoCombinar" FontWeight="SemiBold"
                                 Checked="ModoCombinar_Changed" Margin="0,0,0,10" />
                    <StackPanel x:Name="PanelCrearNuevo" Margin="20,0,0,0">
                        <TextBlock x:Name="LblNombreConector" Foreground="{StaticResource RotoGrayBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtConectorName" Style="{StaticResource RotoTextBox}" MaxLength="25" Width="220" HorizontalAlignment="Left" />
                        <CheckBox x:Name="ChkPredefinido" Margin="0,10,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="7,0,0,0">
                <StackPanel>
                    <RadioButton x:Name="RbInsertarExistente" GroupName="ModoCombinar" FontWeight="SemiBold"
                                 Checked="ModoCombinar_Changed" Margin="0,0,0,10" />
                    <StackPanel x:Name="PanelExistente" Margin="20,0,0,0">
                        <TextBlock x:Name="LblSeleccionarConector" Foreground="{StaticResource RotoGrayBrush}" FontSize="12" Margin="0,0,0,4" />
                        <ComboBox x:Name="CmbConectorExistente" Style="{StaticResource RotoComboFilter}" Width="220"
                                  HorizontalAlignment="Left" SelectionChanged="CmbConectorExistente_SelectionChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Listas de transferencia -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="LblConectoresBD" Style="{StaticResource RotoSectionTitle}" Margin="0,0,0,8" />
                <ListBox Grid.Row="1" x:Name="ListDisponibles" Style="{StaticResource RotoList}" Margin="0,0,10,0" />
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="BtnAdd" Content="&gt;" Style="{StaticResource BtnTransferencia}" Click="BtnAdd_Click" />
                <Button x:Name="BtnAddAll" Content="&gt;&gt;" Style="{StaticResource BtnTransferencia}" Click="BtnAddAll_Click" />
                <Button x:Name="BtnDelete" Content="&lt;" Style="{StaticResource BtnTransferencia}" Click="BtnDelete_Click" />
                <Button x:Name="BtnDeleteAll" Content="&lt;&lt;" Style="{StaticResource BtnTransferencia}" Click="BtnDeleteAll_Click" Margin="0" />
            </StackPanel>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="LblConectoresCombinar" Style="{StaticResource RotoSectionTitle}" Margin="10,0,0,8" />
                <ListBox Grid.Row="1" x:Name="ListACombinar" Style="{StaticResource RotoList}" Margin="10,0,10,0" />
            </Grid>

            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="BtnUp" Content="&#8593;" Style="{StaticResource BtnTransferencia}" Click="BtnUp_Click" />
                <Button x:Name="BtnDown" Content="&#8595;" Style="{StaticResource BtnTransferencia}" Click="BtnDown_Click" Margin="0" />
            </StackPanel>
        </Grid>

        <!-- Barra inferior -->
        <DockPanel Grid.Row="3" LastChildFill="False">
            <TextBlock x:Name="LblInfoConexion" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="{StaticResource RotoGrayBrush}" FontSize="12.5" />

            <Button x:Name="BtnVolver" DockPanel.Dock="Right" Style="{StaticResource RotoButtonSecondary}"
                    Click="BtnVolver_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconBack}" Fill="{StaticResource RotoInkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtBtnVolver" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="BtnGuardar" DockPanel.Dock="Right" Style="{StaticResource RotoButtonPrimary}"
                    Click="BtnGuardar_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconDocument}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtBtnGuardar" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</Window>
