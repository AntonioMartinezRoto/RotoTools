<UserControl
    x:Class="RotoTools.Suite.Views.Exportador.ExportadorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource RotoContentBackgroundBrush}">

    <!--
        Sustituye a ExportacionMenu.cs/.Designer.cs (WinForms): el "menú" original tenía 1 selector
        de XML y 3 botones (WinPerfil/Orgadata/Opera), cada uno abriendo su propio formulario modal
        con new XxxForm(xmlFile).ShowDialog(). "Exportar a Opera" (btn_ExportOpera/lbl_ExportOpera)
        tenía Visible=false en el Designer y nunca se ponía a true en ningún sitio del .cs — UI
        muerta/inalcanzable en la app actual, igual que los botones Exportar/Importar Resources de
        OptionsMenu (ver OpcionesPage): no se migra aquí, así que solo hay 2 tarjetas
        (WinPerfil/Orgadata) en vez de 3.

        Los formularios de exportación en sí (ExportacionWinPerfil/ExportacionOrgadata) reutilizan
        casi toda su lógica de negocio del original por reflexión sobre una instancia oculta — ver
        ExportacionWinPerfilWindow.xaml/ExportacionOrgadataWindow.xaml para el detalle.

        Los iconos de las 2 tarjetas son los logotipos reales de WinPerfil y Orgadata (el software
        externo al que se exporta, no un icono genérico de RotoBrand.xaml): extraídos tal cual de
        btn_ExportWinPerfil.BackgroundImage/btn_ExportOrgadata.BackgroundImage en el
        ExportacionMenu.resx original (recursos de imagen embebidos del Designer de WinForms) y
        añadidos a Assets/ (export_winperfil.png/export_orgadata.png), mismo patrón que logo.png/
        logo_suite.png (ver MainWindow.xaml/DashboardPage.xaml).
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,32">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Border Style="{StaticResource RotoPageBadge}" Background="#F57C00" Margin="0,0,16,0">
                    <Path Data="{StaticResource IconUpload}" Fill="White" Width="20" Height="20" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitulo" Style="{StaticResource RotoPageTitle}" Margin="0" />
                    <TextBlock x:Name="TxtSubtitulo" Foreground="{StaticResource RotoGrayBrush}" FontSize="13" />
                </StackPanel>
            </StackPanel>

            <!-- Antes btn_Xml/lbl_info -->
            <Border Style="{StaticResource RotoCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="TxtFicheroTitulo" Style="{StaticResource RotoSectionTitle}" />
                    <DockPanel LastChildFill="False" Margin="0,10,0,0">
                        <Button x:Name="BtnSelectXml" DockPanel.Dock="Left" Style="{StaticResource RotoCardIconButton}"
                                Click="BtnSelectXml_Click" Margin="0,0,12,0">
                            <Path Data="{StaticResource IconFolderOpen}" Fill="{StaticResource RotoInkBrush}" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <TextBlock x:Name="LblInfo" DockPanel.Dock="Left" VerticalAlignment="Center"
                                   Foreground="{StaticResource RotoGrayBrush}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Antes btn_ExportWinPerfil/lbl_ExportWinPerfil + btn_ExportOrgadata/lbl_ExportOrgadata
                 (btn_ExportOpera excluido, ver comentario arriba) -->
            <UniformGrid Columns="2" Rows="1">
                <Button x:Name="BtnExportWinPerfil" Style="{StaticResource RotoActionCard}" Margin="0,0,6,0"
                        IsEnabled="False" Click="BtnExportWinPerfil_Click">
                    <StackPanel>
                        <!-- Logotipo real de WinPerfil (ver comentario de arriba): ya trae su
                             propio fondo verde, así que se pinta como Background de un Border con
                             esquinas redondeadas (WPF recorta el Background al CornerRadius al
                             renderizar) en vez de ir dentro de un círculo de color genérico. -->
                        <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,0,14">
                            <Border.Background>
                                <ImageBrush ImageSource="/Assets/export_winperfil.png" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <TextBlock x:Name="TxtCardWinPerfilTitulo" Style="{StaticResource RotoSectionTitle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtCardWinPerfilDesc" Foreground="{StaticResource RotoGrayBrush}" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button x:Name="BtnExportOrgadata" Style="{StaticResource RotoActionCard}" Margin="6,0,0,0"
                        IsEnabled="False" Click="BtnExportOrgadata_Click">
                    <StackPanel>
                        <!-- Logotipo real de Orgadata (ver comentario de arriba): a diferencia del
                             de WinPerfil, este PNG tiene fondo transparente, así que se centra
                             sobre una tarjeta cuadrada de color neutro en vez de pintarse como
                             Background a sangre. -->
                        <Border Width="40" Height="40" CornerRadius="10" Background="#F2F2F4" Margin="0,0,0,14">
                            <Image Source="/Assets/export_orgadata.png" Width="26" Height="26" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="TxtCardOrgadataTitulo" Style="{StaticResource RotoSectionTitle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtCardOrgadataDesc" Foreground="{StaticResource RotoGrayBrush}" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
