<Window
    x:Class="RotoTools.Suite.Views.Actualizador.ActualizadorInstalarEscandallosWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Instalar Escandallos"
    Width="620" Height="440"
    MinWidth="560" MinHeight="400"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource RotoContentBackgroundBrush}">

    <!--
        Sustituye a ActualizadorInstalarEscandallos.cs/.Designer.cs (WinForms): mismos 6 grupos de
        escandallos (checkboxes con tooltip listando los códigos de cada grupo, ver
        SetToolTips/GenerarTooltip en el .xaml.cs) + "Seleccionar todos los grupos" + el enlace a
        la instalación individualizada (antes botón cuadrado con icono, ahora una tarjeta clicable
        completa igual que el resto de "entrar en algo" de la suite). Misma lógica de instalación
        (InstallEscandallos), reutilizando tal cual RotoTools.Helpers/RotoTools.EscandalloHelper/
        RotoTools.TranslateManager vía ProjectReference.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Background="{StaticResource RotoNavBackgroundBrush}">
            <TextBlock x:Name="TxtTitulo" Text="Instalar Escandallos" FontSize="17" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" Margin="24,0" />
        </Border>

        <!-- Cuerpo -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,10">

                <DockPanel Margin="0,0,0,10">
                    <TextBlock x:Name="TxtGruposTitulo" Style="{StaticResource RotoSectionTitle}" Margin="0" DockPanel.Dock="Left" VerticalAlignment="Center" />
                    <CheckBox x:Name="ChkSelectAll" DockPanel.Dock="Right" HorizontalAlignment="Right"
                              VerticalAlignment="Center" Checked="ChkSelectAll_CheckedChanged" Unchecked="ChkSelectAll_CheckedChanged" />
                </DockPanel>

                <Border Style="{StaticResource RotoCard}" Margin="0,0,0,16">
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,12,0">
                            <CheckBox x:Name="ChkGestionGeneral" Margin="0,0,0,12" />
                            <CheckBox x:Name="ChkPVC" Margin="0,0,0,12" />
                            <CheckBox x:Name="ChkAlu" Margin="0" />
                        </StackPanel>
                        <StackPanel Margin="12,0,0,0">
                            <CheckBox x:Name="ChkManillas" Margin="0,0,0,12" />
                            <CheckBox x:Name="ChkBombillos" Margin="0,0,0,12" />
                            <CheckBox x:Name="ChkCustomizations" Margin="0" />
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <!-- Instalación individualizada: antes groupBox + botón cuadrado con icono, ahora
                     una tarjeta clicable completa (misma técnica que RotoActionCard, ver
                     BtnFiltrarEscandallos_Click más abajo -> ActualizadorInstalarManualEscandallosWindow). -->
                <Button x:Name="BtnFiltrarEscandallos" Style="{StaticResource RotoActionCard}" Click="BtnFiltrarEscandallos_Click">
                    <DockPanel>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#6A5ACD" Margin="0,0,14,0" DockPanel.Dock="Left">
                            <Path Data="{StaticResource IconClipboard}" Fill="White" Width="16" Height="16" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Path Data="{StaticResource IconArrowRight}" Fill="{StaticResource RotoGrayBrush}" Width="14" Height="14"
                              Stretch="Uniform" DockPanel.Dock="Right" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtInstalacionIndividualizadaTitulo" Style="{StaticResource RotoSectionTitle}" Margin="0" />
                            <TextBlock x:Name="TxtInstalacionIndividualizadaDesc" Foreground="{StaticResource RotoGrayBrush}" FontSize="12.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Pie -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,10">
                <Button x:Name="BtnInstalarEscandallos" Style="{StaticResource RotoButtonPrimary}" Click="BtnInstalarEscandallos_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Fill="White"
                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtBtnInstalarEscandallos" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
