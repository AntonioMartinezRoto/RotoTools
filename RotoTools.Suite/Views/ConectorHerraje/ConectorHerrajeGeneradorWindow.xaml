<Window
    x:Class="RotoTools.Suite.Views.ConectorHerraje.ConectorHerrajeGeneradorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Generar conector" Height="900" Width="1400" MinHeight="600" MinWidth="1050"
    WindowStartupLocation="CenterOwner" WindowState="Maximized"
    Background="{StaticResource RotoContentBackgroundBrush}">

    <!--
        Sustituye a ConectorHerrajeGenerador.cs/.Designer.cs (WinForms): genera el XML del
        conector de herraje (o lo guarda directamente en base de datos) a partir de los Sets que
        ConectorHerrajeMenu ya ha calculado para el tipo de herraje del XML cargado (ver
        ConectorHerrajePage.xaml.cs, BtnGeneraConector_Click, que reutiliza el método privado
        GetSetsToConnector() del menú original vía reflexión: ver comentario allí). El original
        era un diálogo fijo (1639x1148, no maximizable); aquí se abre maximizada/redimensionable
        como el resto de pantallas de la suite.

        La columna "Apertura" del original mostraba un pequeño icono (bitmap embebido en
        Properties.Resources: Opening1..Opening14/Escandallo) según el tipo de apertura de cada
        Set. Esas imágenes no forman parte de este entorno de migración (viven en un .resx del
        proyecto original que no se ha sincronizado aquí), así que por ahora se muestra el tipo de
        apertura como texto (ver SetGridRowVm.ObtenerEtiquetaApertura); se puede sustituir por
        iconos vectoriales más adelante si hace falta.
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Style="{StaticResource RotoPageBadge}" Background="#00838F" Margin="0,0,16,0">
                <Path Data="{StaticResource IconLink}" Fill="White" Width="20" Height="20" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="TxtTitulo" Style="{StaticResource RotoPageTitle}" Margin="0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Guardar (código, predefinido, XML/BBDD) + Buscar (texto y tipos de apertura) -->
        <UniformGrid Grid.Row="1" Columns="2" Rows="1" Margin="0,0,0,14">

            <Border Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock x:Name="TxtGuardarGrupoTitulo" Style="{StaticResource RotoSectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="200" Margin="0,0,20,0">
                            <TextBlock x:Name="LblCodigoConector" Foreground="{StaticResource RotoGrayBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtConectorName" Style="{StaticResource RotoTextBox}" MaxLength="25" />
                            <CheckBox x:Name="ChkPredefinido" Margin="0,10,0,0" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Bottom">
                            <Button x:Name="BtnGuardarXml" Style="{StaticResource RotoButtonPrimary}" Margin="0,0,0,8"
                                    Click="BtnGuardarXml_Click" HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDocument}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock x:Name="TxtBtnGuardarXml" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnGuardarBD" Style="{StaticResource RotoButtonSecondary}"
                                    Click="BtnGuardarBD_Click" HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconUpload}" Fill="{StaticResource RotoInkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock x:Name="TxtBtnGuardarBD" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock x:Name="TxtBuscarGrupoTitulo" Style="{StaticResource RotoSectionTitle}" />
                    <TextBox x:Name="TxtFiltro" Style="{StaticResource RotoTextBox}" Margin="0,0,0,10"
                             TextChanged="TxtFiltro_TextChanged" />
                    <UniformGrid Columns="4" Rows="2">
                        <CheckBox x:Name="ChkVentanas" Margin="0,0,8,6" Click="ChkTipoApertura_Click" />
                        <CheckBox x:Name="ChkBalconeras" Margin="0,0,8,6" Click="ChkTipoApertura_Click" />
                        <CheckBox x:Name="ChkPuertas" Margin="0,0,8,6" Click="ChkTipoApertura_Click" />
                        <CheckBox x:Name="ChkCorrederas" Margin="0,0,0,6" Click="ChkTipoApertura_Click" />
                        <CheckBox x:Name="ChkParalelas" Margin="0,0,8,0" Click="ChkTipoApertura_Click" />
                        <CheckBox x:Name="ChkAbatibles" Margin="0,0,8,0" Click="ChkTipoApertura_Click" />
                        <CheckBox x:Name="ChkPlegables" Margin="0,0,8,0" Click="ChkTipoApertura_Click" />
                        <CheckBox x:Name="ChkElevables" Margin="0,0,0,0" Click="ChkTipoApertura_Click" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Seleccionar todas + total de líneas -->
        <DockPanel Grid.Row="2" Margin="0,0,0,10" LastChildFill="False">
            <CheckBox x:Name="ChkSeleccionarTodas" DockPanel.Dock="Left" Content="Seleccionar todas"
                      Checked="ChkSeleccionarTodas_Checked" Unchecked="ChkSeleccionarTodas_Unchecked" />
            <TextBlock x:Name="LblTotal" DockPanel.Dock="Right" Foreground="{StaticResource RotoGrayBrush}"
                       FontSize="13" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Grid de Sets -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <DataGrid x:Name="GridSets" Style="{StaticResource RotoDataGrid}" RowHeight="NaN">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Escandallo" Binding="{Binding Escandallo}" Width="1.6*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RotoDataGridCellText}">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Apertura" Binding="{Binding Apertura}" Width="1.2*" IsReadOnly="True"
                                         ElementStyle="{StaticResource RotoDataGridCellText}" />
                    <DataGridTextColumn Header="Opciones" Binding="{Binding Opciones}" Width="2*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RotoDataGridCellText}">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="1.6*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RotoDataGridCellText}">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Barra inferior -->
        <DockPanel Grid.Row="4" LastChildFill="False">
            <TextBlock x:Name="LblConectorActivo" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="{StaticResource RotoGrayBrush}" FontSize="12.5" />
            <Button x:Name="BtnVolver" DockPanel.Dock="Right" Style="{StaticResource RotoButtonSecondary}"
                    Click="BtnVolver_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconBack}" Fill="{StaticResource RotoInkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock Text="Volver" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</Window>
