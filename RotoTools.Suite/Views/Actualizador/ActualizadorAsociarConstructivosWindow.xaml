<Window
    x:Class="RotoTools.Suite.Views.Actualizador.ActualizadorAsociarConstructivosWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="clr-namespace:RotoTools.Suite.Services"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="Asociar Constructivos" Height="900" Width="1300" MinHeight="620" MinWidth="1000"
    WindowStartupLocation="CenterOwner" WindowState="Maximized"
    Background="{StaticResource RotoContentBackgroundBrush}">

    <!--
        Nueva (no existía en el original): asocia uno o varios Escandallos (tabla Escandallos) al
        nodo psr:ConstructiveScript (sección "Escandallos") de cada elemento "hoja" del XML embebido
        (comprimido, tabla Dibujos, columna Buffer) de uno o varios dibujos (ver
        DibujoConstructivosService). A diferencia de "Añadir opciones ROTO" no hay que cargar ningún
        XML ni elegir modo modelo/elemento: aquí siempre se aplica por elemento hoja.

        3ª versión del diseño (feedback del usuario sobre las 2 anteriores):
        1) La primera apilaba verticalmente DOS zonas completas de árbol+grid+seleccionados, dejando
           muy poca altura para cada una.
        2) La segunda lo arregló con 2 pestañas ("1. Escandallos" / "2. Dibujos", ver
           BtnTabEscandallos/BtnTabDibujos/CambiarTab) para el árbol+grid de elegir, pero la lista de
           "seleccionados" de cada pestaña quedaba oculta al cambiar de pestaña, y se simplificó a
           chips en vez de grid.
        3) Esta versión: las pestañas siguen existiendo para elegir (arriba, ocupan la mayor parte
           de la altura), pero las dos grids de "seleccionados" (GridEscSeleccionados/
           GridSeleccionados) ahora son una franja FIJA abajo, siempre visible sin importar qué
           pestaña esté activa arriba, para tener en todo momento una visión de qué se va a instalar
           y dónde. Vuelven a ser grids de verdad (Código + Descripción), no chips; la de Escandallos
           además tiene una columna "Variables" editable por fila, porque las variables pueden ser
           distintas para cada escandallo (no se asume ya un único texto compartido).
    -->
    <Window.Resources>
        <Style x:Key="RotoGridIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E9E9EC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Árbol de Escandallos (Nivel1..5, campo Codigo). -->
        <HierarchicalDataTemplate DataType="{x:Type svc:EscandalloTreeNode}" ItemsSource="{Binding Hijos}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                      Fill="{StaticResource RotoGrayBrush}">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="{StaticResource IconFolderOpen}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsHoja}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource IconDocument}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <TextBlock Text="{Binding Texto}" VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Árbol de Dibujos (Nivel1..5, campo Codigo). -->
        <HierarchicalDataTemplate DataType="{x:Type svc:DibujoTreeNode}" ItemsSource="{Binding Hijos}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                      Fill="{StaticResource RotoGrayBrush}">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="{StaticResource IconFolderOpen}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsHoja}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource IconDocument}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <TextBlock Text="{Binding Texto}" VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Placeholder: el tooltip real se asigna en CargarTextos() (DynamicResource, no
             ToolTip="literal" directo, porque estos botones viven dentro de un CellTemplate y se
             instancian una vez por fila). -->
        <sys:String x:Key="TooltipQuitarSeleccionado">Quitar</sys:String>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.3*" MinHeight="220" />
            <RowDefinition Height="8" />
            <RowDefinition Height="0.9*" MinHeight="180" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TxtTitulo" Style="{StaticResource RotoPageTitle}" Margin="0,0,0,4" />
            <TextBlock x:Name="TxtSubtitulo" Foreground="{StaticResource RotoGrayBrush}" FontSize="13" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Pestañas "1. Escandallos" / "2. Dibujos" (control segmentado, no un TabControl real: se
             conmuta la Visibility de PanelEscandallos/PanelDibujos en code-behind). Solo controlan
             qué árbol+grid de ELEGIR se ve arriba: las dos grids de seleccionados de abajo (Grid.Row
             4) son siempre visibles, no dependen de la pestaña activa. -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnTabEscandallos" Grid.Column="0" Style="{StaticResource RotoButtonPrimary}"
                    Margin="0,0,4,0" HorizontalAlignment="Stretch" Click="BtnTabEscandallos_Click" />
            <Button x:Name="BtnTabDibujos" Grid.Column="1" Style="{StaticResource RotoButtonSecondary}"
                    Margin="4,0,0,0" HorizontalAlignment="Stretch" Click="BtnTabDibujos_Click" />
        </Grid>

        <!-- Contenido de las 2 pestañas (elegir), superpuesto en la misma celda: solo una es visible
             cada vez (ver CambiarTab). -->
        <Grid Grid.Row="2">

            <!-- ===== Pestaña 1: elegir Escandallos ===== -->
            <Grid x:Name="PanelEscandallos">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" MinWidth="260" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="2*" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="TxtCarpetasEscandallos" Style="{StaticResource RotoSectionTitle}" Margin="0,0,0,10" />
                        <TreeView Grid.Row="1" x:Name="TreeEscandallos" BorderThickness="0"
                                  MouseDoubleClick="TreeEscandallos_MouseDoubleClick">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="LblTodosEscandallos" Style="{StaticResource RotoSectionTitle}" Margin="0,0,0,10" />
                        <TextBox Grid.Row="1" x:Name="TxtBuscarEscandallos" Style="{StaticResource RotoTextBox}" Width="220"
                                 HorizontalAlignment="Left" Margin="0,0,0,10" TextChanged="TxtBuscarEscandallos_TextChanged" />
                        <DataGrid Grid.Row="2" x:Name="GridEscandallos" Style="{StaticResource RotoDataGrid}" IsReadOnly="True"
                                  MouseDoubleClick="GridEscandallos_MouseDoubleClick"
                                  SelectionChanged="GridEscandallos_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ColEscCodigo" Header="Código" Binding="{Binding Codigo}" Width="170" ElementStyle="{StaticResource RotoDataGridCellText}" />
                                <DataGridTextColumn x:Name="ColEscDescripcion" Header="Descripción" Binding="{Binding Descripcion}" Width="*" ElementStyle="{StaticResource RotoDataGridCellText}" />
                                <DataGridTextColumn x:Name="ColEscNivel1" Header="Nivel 1" Binding="{Binding Nivel1}" Width="95" ElementStyle="{StaticResource RotoDataGridCellText}" />
                                <DataGridTextColumn x:Name="ColEscNivel2" Header="Nivel 2" Binding="{Binding Nivel2}" Width="95" ElementStyle="{StaticResource RotoDataGridCellText}" />
                                <DataGridTextColumn x:Name="ColEscNivel3" Header="Nivel 3" Binding="{Binding Nivel3}" Width="95" ElementStyle="{StaticResource RotoDataGridCellText}" />
                                <DataGridTextColumn x:Name="ColEscNivel4" Header="Nivel 4" Binding="{Binding Nivel4}" Width="95" ElementStyle="{StaticResource RotoDataGridCellText}" />
                                <DataGridTextColumn x:Name="ColEscNivel5" Header="Nivel 5" Binding="{Binding Nivel5}" Width="95" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Pestaña 2: elegir Dibujos ===== -->
            <Grid x:Name="PanelDibujos" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" MinWidth="260" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="2*" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="TxtCarpetasDibujos" Style="{StaticResource RotoSectionTitle}" Margin="0,0,0,10" />
                        <TreeView Grid.Row="1" x:Name="TreeDibujos" BorderThickness="0"
                                  MouseDoubleClick="TreeDibujos_MouseDoubleClick">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="LblTodosDibujos" Style="{StaticResource RotoSectionTitle}" Margin="0,0,0,10" />
                        <TextBox Grid.Row="1" x:Name="TxtBuscarDibujos" Style="{StaticResource RotoTextBox}" Width="220"
                                 HorizontalAlignment="Left" Margin="0,0,0,10" TextChanged="TxtBuscarDibujos_TextChanged" />
                        <DataGrid Grid.Row="2" x:Name="GridDibujos" Style="{StaticResource RotoDataGrid}" IsReadOnly="True"
                                  MouseDoubleClick="GridDibujos_MouseDoubleClick"
                                  SelectionChanged="GridDibujos_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ColDibujoCodigo" Header="Código" Binding="{Binding Codigo}" Width="130" ElementStyle="{StaticResource RotoDataGridCellText}" />
                                <DataGridTextColumn x:Name="ColDibujoDescripcion" Header="Descripción" Binding="{Binding Descripcion}" Width="*" ElementStyle="{StaticResource RotoDataGridCellText}" />
                                <DataGridTextColumn x:Name="ColDibujoSistema" Header="Sistema" Binding="{Binding Sistema}" Width="130" ElementStyle="{StaticResource RotoDataGridCellText}" />
                                <DataGridTextColumn x:Name="ColDibujoNivel1" Header="Nivel 1" Binding="{Binding Nivel1}" Width="95" ElementStyle="{StaticResource RotoDataGridCellText}" />
                                <DataGridTextColumn x:Name="ColDibujoNivel2" Header="Nivel 2" Binding="{Binding Nivel2}" Width="95" ElementStyle="{StaticResource RotoDataGridCellText}" />
                                <DataGridTextColumn x:Name="ColDibujoNivel3" Header="Nivel 3" Binding="{Binding Nivel3}" Width="95" ElementStyle="{StaticResource RotoDataGridCellText}" />
                                <DataGridTextColumn x:Name="ColDibujoNivel4" Header="Nivel 4" Binding="{Binding Nivel4}" Width="95" ElementStyle="{StaticResource RotoDataGridCellText}" />
                                <DataGridTextColumn x:Name="ColDibujoNivel5" Header="Nivel 5" Binding="{Binding Nivel5}" Width="95" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <GridSplitter Grid.Row="3" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- Franja FIJA, siempre visible sin importar la pestaña activa arriba: las dos grids de
             seleccionados, una junto a la otra, para ver en todo momento qué escandallos (con sus
             variables) se van a asociar y a qué dibujos. -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" MinWidth="320" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- Escandallos seleccionados (con Variables editable por fila: cada escandallo puede
                 llevar una definición distinta, no se comparte un único texto). -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="LblEscSeleccionados" DockPanel.Dock="Left" Style="{StaticResource RotoSectionTitle}" VerticalAlignment="Center" />
                        <Button x:Name="BtnLimpiarEscSeleccionados" DockPanel.Dock="Right" Style="{StaticResource RotoButtonSecondary}"
                                HorizontalAlignment="Right" Click="BtnLimpiarEscSeleccionados_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconTrash}" Fill="{StaticResource RotoInkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock x:Name="TxtBtnLimpiarEscSeleccionados" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <DataGrid Grid.Row="1" x:Name="GridEscSeleccionados" Style="{StaticResource RotoDataGrid}" IsReadOnly="False"
                              AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RotoGridIconButton}" Click="BtnQuitarEscSeleccionado_Click" ToolTip="{DynamicResource TooltipQuitarSeleccionado}">
                                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource RotoGrayBrush}" Width="12" Height="12" Stretch="Uniform" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="ColEscSelCodigo" Header="Código" Binding="{Binding Codigo}" Width="170" IsReadOnly="True" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColEscSelDescripcion" Header="Descripción" Binding="{Binding Descripcion}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColEscSelVariables" Header="Variables" Binding="{Binding Variables, UpdateSourceTrigger=PropertyChanged}" Width="180" ElementStyle="{StaticResource RotoDataGridCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Dibujos seleccionados. -->
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="LblSeleccionados" DockPanel.Dock="Left" Style="{StaticResource RotoSectionTitle}" VerticalAlignment="Center" />
                        <Button x:Name="BtnLimpiarSeleccionados" DockPanel.Dock="Right" Style="{StaticResource RotoButtonSecondary}"
                                HorizontalAlignment="Right" Click="BtnLimpiarSeleccionados_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconTrash}" Fill="{StaticResource RotoInkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock x:Name="TxtBtnLimpiarSeleccionados" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <DataGrid Grid.Row="1" x:Name="GridSeleccionados" Style="{StaticResource RotoDataGrid}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RotoGridIconButton}" Click="BtnQuitarSeleccionado_Click" ToolTip="{DynamicResource TooltipQuitarSeleccionado}">
                                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource RotoGrayBrush}" Width="12" Height="12" Stretch="Uniform" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="ColSelCodigo" Header="Código" Binding="{Binding Codigo}" Width="130" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColSelDescripcion" Header="Descripción" Binding="{Binding Descripcion}" Width="*" ElementStyle="{StaticResource RotoDataGridCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Progreso: aplicar puede tardar si hay muchos dibujos seleccionados (cada uno hace una
             lectura + escritura en BBDD), así que se muestra una barra de progreso mientras dura. -->
        <Border Grid.Row="5" x:Name="PanelProgreso" Visibility="Collapsed" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock x:Name="LblProgreso" Margin="0,0,0,6" Foreground="{StaticResource RotoGrayBrush}" FontSize="12.5" />
                <ProgressBar x:Name="BarraProgreso" Height="8" Minimum="0" Maximum="1" Value="0" />
            </StackPanel>
        </Border>

        <!-- Barra inferior -->
        <DockPanel Grid.Row="6" Margin="0,14,0,0" LastChildFill="False">
            <Button x:Name="BtnAplicar" DockPanel.Dock="Left" Style="{StaticResource RotoButtonPrimary}"
                    Click="BtnAplicar_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconPlay}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtBtnAplicar" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="BtnVolver" DockPanel.Dock="Right" Style="{StaticResource RotoButtonSecondary}"
                    Click="BtnVolver_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconBack}" Fill="{StaticResource RotoInkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtBtnVolver" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</Window>
