<Window
    x:Class="RotoTools.Suite.Views.ConfiguradorOpciones.ConfiguradorOpcionesQuitarRotoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="clr-namespace:RotoTools.Suite.Services"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="Quitar opciones ROTO" Height="900" Width="1400" MinHeight="620" MinWidth="1000"
    WindowStartupLocation="CenterOwner" WindowState="Maximized"
    Background="{StaticResource RotoContentBackgroundBrush}">

    <!--
        Nueva (no existía en el original): operación inversa de ConfiguradorOpcionesAnadirRotoWindow.
        Quita, del XML embebido (comprimido, tabla Dibujos, columna Buffer) de uno o varios dibujos,
        ya sea del nodo raíz del modelo o de cada elemento hoja: (1) todas las opciones cuyo nombre
        empieza por "RO_" y (2) la carpeta (psr:Level) elegida por el usuario en el árbol de
        carpetas de Opciones. A diferencia de Añadir, aquí no hace falta cargar ningún fichero XML:
        no hay que "traer" nada, solo quitarlo. Ventana independiente (y no un modo dentro de la
        misma ventana de Añadir) para no mezclar una operación destructiva e irreversible con una
        aditiva en el mismo formulario.
    -->
    <Window.Resources>
        <Style x:Key="RotoGridIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E9E9EC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icono de carpeta para los nodos de nivel, icono de ventana (IconWindowModel) para los
             dibujos (hojas): mismo criterio que ConfiguradorOpcionesAnadirRotoWindow. -->
        <HierarchicalDataTemplate DataType="{x:Type svc:DibujoTreeNode}" ItemsSource="{Binding Hijos}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                      Fill="{StaticResource RotoGrayBrush}">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="{StaticResource IconFolderOpen}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsHoja}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource IconWindowModel}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <TextBlock Text="{Binding Texto}" VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Placeholder: el tooltip real se asigna en CargarTextos() (DynamicResource, no
             ToolTip="literal" directo, porque este botón vive dentro de un CellTemplate y se
             instancia una vez por fila; un x:Name ahí no sería accesible desde el code-behind). -->
        <sys:String x:Key="TooltipQuitarSeleccionado">Quitar</sys:String>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.1*" MinHeight="220" />
            <RowDefinition Height="8" />
            <RowDefinition Height="1*" MinHeight="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TxtTitulo" Style="{StaticResource RotoPageTitle}" Margin="0,0,0,4" />
            <TextBlock x:Name="TxtSubtitulo" Foreground="{StaticResource RotoGrayBrush}" FontSize="13" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Modo (modelo general / por elemento) + carpeta a quitar (psr:Level): no se asume que
             la carpeta se llame siempre "ROTO", los usuarios de Preference pueden haberla movido a
             otro sitio del árbol de opciones. Se elige en un árbol (ver
             SeleccionarCarpetaOpcionesWindow), no escribiéndola a mano, para evitar errores de
             ruta. A diferencia de Añadir, no hay aquí ningún paso de carga de fichero XML: las
             opciones a quitar (todas las "RO_*") no hace falta indicarlas, se detectan por nombre. -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="RbModoModelo" GroupName="ModoQuitar" IsChecked="True" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <RadioButton x:Name="RbModoElemento" GroupName="ModoQuitar" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LblCarpetaDestino" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button x:Name="BtnElegirCarpeta" Style="{StaticResource RotoButtonSecondary}"
                            Click="BtnElegirCarpeta_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolderOpen}" Fill="{StaticResource RotoInkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock x:Name="TxtBtnElegirCarpeta" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="LblCarpetaDestinoElegida" VerticalAlignment="Center"
                               Margin="12,0,0,0" Foreground="{StaticResource RotoGrayBrush}" FontSize="12.5" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Árbol de carpetas | Todos los dibujos -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="300" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="2*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="TxtCarpetas" Style="{StaticResource RotoSectionTitle}" Margin="0,0,0,10" />
                    <TreeView Grid.Row="1" x:Name="TreeDibujos" BorderThickness="0"
                              MouseDoubleClick="TreeDibujos_MouseDoubleClick">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="LblTodosDibujos" Style="{StaticResource RotoSectionTitle}" Margin="0,0,0,10" />
                    <TextBox Grid.Row="1" x:Name="TxtBuscarDibujos" Style="{StaticResource RotoTextBox}" Width="220"
                             HorizontalAlignment="Left" Margin="0,0,0,10" TextChanged="TxtBuscarDibujos_TextChanged" />
                    <DataGrid Grid.Row="2" x:Name="GridDibujos" Style="{StaticResource RotoDataGrid}" IsReadOnly="True"
                              MouseDoubleClick="GridDibujos_MouseDoubleClick"
                              SelectionChanged="GridDibujos_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColDibujoCodigo" Header="Código" Binding="{Binding Codigo}" Width="130" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColDibujoDescripcion" Header="Descripción" Binding="{Binding Descripcion}" Width="*" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColDibujoSistema" Header="Sistema" Binding="{Binding Sistema}" Width="140" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColDibujoNivel1" Header="Nivel 1" Binding="{Binding Nivel1}" Width="100" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColDibujoNivel2" Header="Nivel 2" Binding="{Binding Nivel2}" Width="100" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColDibujoNivel3" Header="Nivel 3" Binding="{Binding Nivel3}" Width="100" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColDibujoNivel4" Header="Nivel 4" Binding="{Binding Nivel4}" Width="100" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn x:Name="ColDibujoNivel5" Header="Nivel 5" Binding="{Binding Nivel5}" Width="100" ElementStyle="{StaticResource RotoDataGridCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="3" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- Dibujos seleccionados -->
        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock x:Name="LblSeleccionados" DockPanel.Dock="Left" Style="{StaticResource RotoSectionTitle}" VerticalAlignment="Center" />
                    <Button x:Name="BtnLimpiarSeleccionados" DockPanel.Dock="Right" Style="{StaticResource RotoButtonSecondary}"
                            HorizontalAlignment="Right" Click="BtnLimpiarSeleccionados_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTrash}" Fill="{StaticResource RotoInkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock x:Name="TxtBtnLimpiarSeleccionados" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DockPanel>

                <DataGrid Grid.Row="1" x:Name="GridSeleccionados" Style="{StaticResource RotoDataGrid}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RotoGridIconButton}" Click="BtnQuitarSeleccionado_Click" ToolTip="{DynamicResource TooltipQuitarSeleccionado}">
                                        <Path Data="{StaticResource IconClose}" Fill="{StaticResource RotoGrayBrush}" Width="12" Height="12" Stretch="Uniform" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="ColSelCodigo" Header="Código" Binding="{Binding Codigo}" Width="150" ElementStyle="{StaticResource RotoDataGridCellText}" />
                        <DataGridTextColumn x:Name="ColSelDescripcion" Header="Descripción" Binding="{Binding Descripcion}" Width="*" ElementStyle="{StaticResource RotoDataGridCellText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Progreso: quitar puede tardar si hay muchos dibujos seleccionados (cada uno hace una
             lectura + escritura en BBDD), así que se muestra una barra de progreso mientras dura
             (oculta el resto del tiempo, ver MostrarProgreso/OcultarProgreso). -->
        <Border Grid.Row="5" x:Name="PanelProgreso" Visibility="Collapsed" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="LblProgreso" Margin="0,0,0,6" Foreground="{StaticResource RotoGrayBrush}" FontSize="12.5" />
                <ProgressBar x:Name="BarraProgreso" Height="8" Minimum="0" Maximum="1" Value="0" />
            </StackPanel>
        </Border>

        <!-- Barra inferior -->
        <DockPanel Grid.Row="6" LastChildFill="False">
            <Button x:Name="BtnAplicar" DockPanel.Dock="Left" Style="{StaticResource RotoButtonPrimary}"
                    Click="BtnAplicar_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconTrash}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtBtnAplicar" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="BtnVolver" DockPanel.Dock="Right" Style="{StaticResource RotoButtonSecondary}"
                    Click="BtnVolver_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconBack}" Fill="{StaticResource RotoInkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtBtnVolver" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</Window>
