<UserControl
    x:Class="RotoTools.Suite.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource RotoContentBackgroundBrush}">

    <ScrollViewer Padding="36" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Image Source="/Assets/logo_suite.png" Height="52" Margin="0,0,18,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtBienvenida" Style="{StaticResource RotoPageTitle}" Margin="0" />
                    <TextBlock x:Name="TxtSubtitulo" Foreground="{StaticResource RotoGrayBrush}" FontSize="14" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="TxtDescripcion"
                       TextWrapping="Wrap" Margin="0,12,0,20"
                       Foreground="{StaticResource RotoInkBrush}" FontSize="14" />

            <Border Background="#FFF4CC" CornerRadius="6" Padding="12,8" Margin="0,0,0,24" HorizontalAlignment="Left">
                <TextBlock x:Name="TxtAvisoFase" FontSize="12.5" Foreground="#7A5B00" TextWrapping="Wrap" MaxWidth="800" />
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
