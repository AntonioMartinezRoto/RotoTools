<Window
    x:Class="RotoTools.Suite.Views.Cam.CamInfoOperacionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Información de la operación" Height="720" Width="1100" MinHeight="360" MinWidth="640"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource RotoContentBackgroundBrush}">

    <!--
        Sustituye a CamInfoOperacion.cs (WinForms): diálogo puramente informativo/de solo lectura
        que muestra todas las apariciones (por herraje) de una operación. Sin botones de acción en
        el original (solo se cerraba con la X de la ventana); aquí se añade un botón "Cerrar" por
        comodidad, sin cambiar el comportamiento de solo lectura.
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitulo" Grid.Row="0" Style="{StaticResource RotoPageTitle}" Margin="0,0,0,14" />

        <DataGrid Grid.Row="1" x:Name="GridDetalle" Style="{StaticResource RotoDataGrid}" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fitting Id" Binding="{Binding FittingID}" Width="0.8*" ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
                <DataGridTextColumn Header="Artículo" Binding="{Binding Article}" Width="*" ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="2*" ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
                <DataGridTextColumn Header="Posición" Binding="{Binding X}" Width="0.8*" ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
                <DataGridTextColumn Header="SD Posición" Binding="{Binding SetDescriptionXPosition}" Width="0.8*" ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
                <DataGridTextColumn Header="Ubicación" Binding="{Binding Location}" Width="0.8*" ElementStyle="{StaticResource RotoDataGridCellText}" EditingElementStyle="{StaticResource RotoDataGridCellEditText}" />
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" x:Name="BtnCerrar" Style="{StaticResource RotoButtonPrimary}"
                HorizontalAlignment="Right" Margin="0,14,0,0" Click="BtnCerrar_Click" Content="Cerrar" />
    </Grid>
</Window>
