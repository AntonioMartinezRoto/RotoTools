<UserControl
    x:Class="RotoTools.Suite.Views.ConectorHerraje.ConectorHerrajePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource RotoContentBackgroundBrush}">

    <!--
        Sustituye a ConectorHerrajeMenu.cs/.Designer.cs (WinForms): carga de XML de herrajes y
        menú de las 3 acciones del módulo. Los 3 submódulos ya están migrados: Generar conector
        de herraje -> ConectorHerrajeGeneradorWindow, Combinar conectores de herraje ->
        ConectorHerrajeCombinarWindow, Revisión de sets -> ConectorHerrajeRevisionSetsWindow (ver
        ConectorHerrajePage.xaml.cs).

        Reutiliza tal cual la lógica de negocio del proyecto original vía ProjectReference:
        RotoTools.XmlLoader (misma carga por namespace "hw", igual que CamPage), RotoTools.Helpers
        (IsVersionPrefSuiteCompatible, GetConectorActivo) y RotoEntities.XmlData.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,32">

            <!-- Cabecera -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Border Style="{StaticResource RotoPageBadge}" Background="#00838F" Margin="0,0,16,0">
                    <Path Data="{StaticResource IconLink}" Fill="White" Width="20" Height="20" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitulo" Style="{StaticResource RotoPageTitle}" Margin="0" />
                    <TextBlock x:Name="TxtSubtitulo" Foreground="{StaticResource RotoGrayBrush}" FontSize="13" />
                </StackPanel>
            </StackPanel>

            <!-- Aviso de base de datos no compatible: equivalente a ShowVersionNoCompatible
                 (ConectorHerrajeMenu.cs), oculto salvo que IsVersionPrefSuiteCompatible() sea
                 false. -->
            <Border x:Name="BorderAvisoVersion" Background="#F8D7D7" BorderBrush="#D9534F" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,16" Visibility="Collapsed">
                <TextBlock x:Name="TxtAvisoVersion" Foreground="#8A1F1F" FontSize="12.5" TextWrapping="Wrap" />
            </Border>

            <!-- Barra de carga de XML (mismo criterio que CamPage) -->
            <Border Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <DockPanel LastChildFill="False">
                    <Button x:Name="BtnLoadXml" DockPanel.Dock="Left" Style="{StaticResource RotoButtonPrimary}"
                            Click="BtnLoadXml_Click" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolderOpen}" Fill="White" Width="16" Height="16" Stretch="Uniform"
                                  Margin="0,0,8,0" />
                            <TextBlock x:Name="TxtBtnCargarXml" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="LblXml" DockPanel.Dock="Left" VerticalAlignment="Center"
                               Foreground="{StaticResource RotoGrayBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="LblConectorActivo" DockPanel.Dock="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource RotoGrayBrush}" FontSize="12.5" />
                </DockPanel>
            </Border>

            <!-- Tarjetas de acción: mismas 3 que ConectorHerrajeMenu (pnlCard1/2/3) -->
            <UniformGrid Columns="3" Rows="1">

                <!-- Tarjeta 1: Generar Conector de Herraje (+ checkbox "Balconeras AE con Sets de AI") -->
                <Button x:Name="BtnGeneraConector" Style="{StaticResource RotoActionCard}" Margin="0,0,12,0"
                        Click="BtnGeneraConector_Click">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="20" Background="#00838F" Margin="0,0,0,14">
                            <Path Data="{StaticResource IconLink}" Fill="White" Width="18" Height="18" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="TxtCard1Titulo" Style="{StaticResource RotoSectionTitle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtCard1Desc"
                                   Foreground="{StaticResource RotoGrayBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <CheckBox x:Name="ChkConfigAE" Click="ChkConfigAE_Click" />
                    </StackPanel>
                </Button>

                <!-- Tarjeta 2: Combinar Conectores de Herraje -->
                <Button x:Name="BtnCombinarConectores" Style="{StaticResource RotoActionCard}" Margin="6,0,6,0"
                        Click="BtnCombinarConectores_Click">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="20" Background="#1976D2" Margin="0,0,0,14">
                            <Path Data="{StaticResource IconDuplicate}" Fill="White" Width="18" Height="18" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="TxtCard2Titulo" Style="{StaticResource RotoSectionTitle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtCard2Desc"
                                   Foreground="{StaticResource RotoGrayBrush}" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <!-- Tarjeta 3: Revisión de Sets -->
                <Button x:Name="BtnSetsNoUtilizados" Style="{StaticResource RotoActionCard}" Margin="12,0,0,0"
                        Click="BtnSetsNoUtilizados_Click">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="20" Background="#F57C00" Margin="0,0,0,14">
                            <Path Data="{StaticResource IconClipboard}" Fill="White" Width="18" Height="18" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="TxtCard3Titulo" Style="{StaticResource RotoSectionTitle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtCard3Desc"
                                   Foreground="{StaticResource RotoGrayBrush}" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
