<Window
    x:Class="RotoTools.Suite.Views.ConectorHerraje.ConectorHerrajeRevisionSetsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Revisión de Sets" Height="900" Width="1300" MinHeight="600" MinWidth="1000"
    WindowStartupLocation="CenterOwner" WindowState="Maximized"
    Background="{StaticResource RotoContentBackgroundBrush}">

    <!--
        Sustituye a ConectorHerrajeRevisionSets.cs/.Designer.cs (WinForms): comprueba, para un
        conector de herraje ya guardado en BBDD, qué Sets del XML cargado están/no están
        incluidos en él, y qué códigos del conector no tienen ningún Set correspondiente en el
        XML (para poder depurarlos). El original era un diálogo fijo (784x471, no maximizable)
        con un TabControl de 3 pestañas; aquí se abre maximizada/redimensionable como el resto de
        pantallas de esta suite, y las 3 pestañas se reproducen con un pequeño selector propio
        (RadioButton con aspecto de "chip") en vez de un TabControl nativo, para mantener el
        mismo lenguaje visual que el resto de RotoBrand.xaml (el TabControl "de fábrica" de WPF
        no encaja con ese estilo y aquí no se ha creado ningún tema propio para él).

        Esta ventana solo se abre desde ConectorHerrajePage con el constructor que recibe un
        XmlData ya cargado (único punto de uso real en el original: btn_SetsNoUtilizados_Click);
        los otros dos constructores del original (sin XmlData, o con XmlData+Connector) no tenían
        ninguna llamada real en toda la solución, así que no se han portado.

        Pequeña mejora deliberada sobre el original: las listas internas que alimentan la
        exportación a Excel (Sets incluidos/no incluidos, códigos sin Set en XML) se limpiaban en
        el original SOLO cuando se creaba la ventana, no cada vez que se recalculaban (cambio de
        conector o de proveedor): así, sus tamaños solo podían crecer, acumulando duplicados si el
        usuario cambiaba de conector varias veces. Aquí se reinician en cada recálculo.

        El filtro de la 3ª pestaña (txt_FiltroCodigoNoXml en el original) estaba completamente
        comentado en el código fuente (no hacía nada); se omite aquí en vez de reproducir un
        cuadro de texto que nunca filtraba nada.
    -->
    <Window.Resources>
        <Style x:Key="TabChip" TargetType="RadioButton">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource RotoInkBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="White" BorderBrush="{StaticResource RotoBorderBrush}"
                                BorderThickness="1" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F2F2F4" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource RotoRedBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource RotoRedBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RotoGridIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E9E9EC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Style="{StaticResource RotoPageBadge}" Background="#00838F" Margin="0,0,16,0">
                <Path Data="{StaticResource IconLink}" Fill="White" Width="20" Height="20" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Revisión de Sets" Style="{StaticResource RotoPageTitle}" Margin="0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Selección de conector + filtro de proveedor -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="260" Margin="0,0,24,0">
                    <TextBlock Text="Conector" Foreground="{StaticResource RotoGrayBrush}" FontSize="12" Margin="0,0,0,4" />
                    <ComboBox x:Name="CmbConectores" Style="{StaticResource RotoComboFilter}"
                              SelectionChanged="CmbConectores_SelectionChanged" />
                </StackPanel>
                <StackPanel Width="260">
                    <TextBlock Text="Hardware Supplier" Foreground="{StaticResource RotoGrayBrush}" FontSize="12" Margin="0,0,0,4" />
                    <ComboBox x:Name="CmbHardwareSupplier" Style="{StaticResource RotoComboFilter}"
                              SelectionChanged="CmbHardwareSupplier_SelectionChanged" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Selector de pestañas -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton x:Name="RbTabIncluidos" GroupName="TabsRevisionSets" Style="{StaticResource TabChip}"
                         Content="Sets incluidos en Conector" IsChecked="True" Checked="Tab_Changed" />
            <RadioButton x:Name="RbTabNoIncluidos" GroupName="TabsRevisionSets" Style="{StaticResource TabChip}"
                         Content="Sets NO incluidos en Conector" Checked="Tab_Changed" />
            <RadioButton x:Name="RbTabCodigos" GroupName="TabsRevisionSets" Style="{StaticResource TabChip}"
                         Content="Códigos que no están en XML" Checked="Tab_Changed" />
        </StackPanel>

        <!-- Contenido de la pestaña activa -->
        <Grid Grid.Row="3" Margin="0,0,0,14">

            <!-- Pestaña: Sets incluidos -->
            <Border x:Name="PanelIncluidos" Background="White" BorderBrush="{StaticResource RotoBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                        <TextBox x:Name="TxtFiltroIncluidos" DockPanel.Dock="Left" Style="{StaticResource RotoTextBox}"
                                 Width="240" TextChanged="TxtFiltroIncluidos_TextChanged" />
                        <TextBlock Text="Buscar" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Button x:Name="BtnExportIncluidos" DockPanel.Dock="Right" Style="{StaticResource RotoGridIconButton}"
                                Click="BtnExportIncluidos_Click" ToolTip="Exportar a Excel">
                            <Path Data="{StaticResource IconDownload}" Fill="{StaticResource RotoGrayBrush}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                    </DockPanel>
                    <TextBlock x:Name="LblTotalSetsIncluidos" Grid.Row="1" Foreground="{StaticResource RotoGrayBrush}"
                               FontSize="12.5" Margin="0,0,0,8" />
                    <DataGrid x:Name="GridSetsIncluidos" Grid.Row="2" Style="{StaticResource RotoDataGrid}"
                              IsReadOnly="True" MouseDoubleClick="GridSets_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="120" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn Header="Set" Binding="{Binding Code}" Width="*" ElementStyle="{StaticResource RotoDataGridCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Pestaña: Sets NO incluidos -->
            <Border x:Name="PanelNoIncluidos" Background="White" BorderBrush="{StaticResource RotoBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                        <TextBox x:Name="TxtFiltroNoIncluidos" DockPanel.Dock="Left" Style="{StaticResource RotoTextBox}"
                                 Width="240" TextChanged="TxtFiltroNoIncluidos_TextChanged" />
                        <TextBlock Text="Buscar" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Button x:Name="BtnExportNoIncluidos" DockPanel.Dock="Right" Style="{StaticResource RotoGridIconButton}"
                                Click="BtnExportNoIncluidos_Click" ToolTip="Exportar a Excel">
                            <Path Data="{StaticResource IconDownload}" Fill="{StaticResource RotoGrayBrush}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                    </DockPanel>
                    <TextBlock x:Name="LblTotalSetsNoIncluidos" Grid.Row="1" Foreground="{StaticResource RotoGrayBrush}"
                               FontSize="12.5" Margin="0,0,0,8" />
                    <DataGrid x:Name="GridSetsNoIncluidos" Grid.Row="2" Style="{StaticResource RotoDataGrid}"
                              IsReadOnly="True" MouseDoubleClick="GridSets_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="120" ElementStyle="{StaticResource RotoDataGridCellText}" />
                            <DataGridTextColumn Header="Set" Binding="{Binding Code}" Width="*" ElementStyle="{StaticResource RotoDataGridCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Pestaña: Códigos que no están en XML -->
            <Border x:Name="PanelCodigos" Background="White" BorderBrush="{StaticResource RotoBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock x:Name="LblTotalCodigosNoXml" DockPanel.Dock="Left" VerticalAlignment="Center"
                                   Foreground="{StaticResource RotoGrayBrush}" FontSize="12.5" />
                        <Button x:Name="BtnEliminarLineas" DockPanel.Dock="Right" Style="{StaticResource RotoButtonSecondary}"
                                Click="BtnEliminarLineas_Click" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconTrash}" Fill="{StaticResource RotoInkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Eliminar líneas no usadas" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnExportCodigos" DockPanel.Dock="Right" Style="{StaticResource RotoGridIconButton}"
                                Click="BtnExportCodigos_Click" ToolTip="Exportar a Excel">
                            <Path Data="{StaticResource IconDownload}" Fill="{StaticResource RotoGrayBrush}" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                    </DockPanel>
                    <ListBox x:Name="ListCodigosNoXml" Grid.Row="1" Style="{StaticResource RotoList}"
                             MouseDoubleClick="ListCodigosNoXml_MouseDoubleClick" />
                </Grid>
            </Border>
        </Grid>

        <!-- Barra inferior -->
        <DockPanel Grid.Row="4" LastChildFill="False">
            <TextBlock x:Name="LblConectorActivo" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="{StaticResource RotoGrayBrush}" FontSize="12.5" />
            <TextBlock x:Name="LblCopiado" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="20,0,0,0"
                       Foreground="{StaticResource RotoRedBrush}" FontSize="12.5" FontWeight="SemiBold"
                       Visibility="Collapsed" />
            <Button x:Name="BtnVolver" DockPanel.Dock="Right" Style="{StaticResource RotoButtonSecondary}"
                    Click="BtnVolver_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconBack}" Fill="{StaticResource RotoInkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock Text="Volver" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</Window>
