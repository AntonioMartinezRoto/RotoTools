<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Paleta corporativa Roto, extraída del logo real (images/logo.png): rojo #FE0009 y gris
        #737378. Sustituye el fondo blanco/gris plano de la app WinForms original por un look de
        "suite" moderna: panel de navegación oscuro con acento rojo, área de contenido clara con
        un degradado sutil y tarjetas con sombra.
        Todo lo de este fichero es WPF estándar (Style/ControlTemplate/Trigger): no depende de
        ninguna librería de terceros.
    -->

    <Color x:Key="RotoRedColor">#FE0009</Color>
    <Color x:Key="RotoRedDarkColor">#C40007</Color>
    <Color x:Key="RotoGrayColor">#737378</Color>
    <Color x:Key="RotoInkColor">#1F2126</Color>
    <Color x:Key="RotoInkLightColor">#2B2E35</Color>

    <SolidColorBrush x:Key="RotoRedBrush" Color="{StaticResource RotoRedColor}" />
    <SolidColorBrush x:Key="RotoRedDarkBrush" Color="{StaticResource RotoRedDarkColor}" />
    <SolidColorBrush x:Key="RotoGrayBrush" Color="{StaticResource RotoGrayColor}" />
    <SolidColorBrush x:Key="RotoInkBrush" Color="{StaticResource RotoInkColor}" />
    <SolidColorBrush x:Key="RotoInkLightBrush" Color="{StaticResource RotoInkLightColor}" />
    <SolidColorBrush x:Key="RotoNavHoverBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="RotoNavSelectedBrush" Color="{StaticResource RotoRedColor}" />
    <SolidColorBrush x:Key="RotoBorderBrush" Color="#E3E5EA" />

    <LinearGradientBrush x:Key="RotoNavBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource RotoInkColor}" Offset="0" />
        <GradientStop Color="{StaticResource RotoInkLightColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RotoContentBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F6F7F9" Offset="0" />
        <GradientStop Color="#ECEEF2" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="RotoCardBackgroundBrush" Color="#FFFFFF" />

    <!-- ===================== Iconos ===================== -->
    <!-- Glifos vectoriales propios (Geometry, en un lienzo de 24x24), dibujados a mano con líneas
         rectas para que su resultado sea 100% previsible y no dependan de ningún paquete de iconos
         de terceros ni de nombres de glifo que haya que adivinar (la lección del primer intento
         con WPF-UI). Se usan con <Path Data="{StaticResource IconX}" .../>; al ser Geometry (un
         Freezable) el mismo recurso se puede reutilizar en varios Path sin problema. -->

    <Geometry x:Key="IconFolderOpen">M3,7 L9,7 L11,9 L21,9 L21,17 L3,17 Z</Geometry>

    <!-- Flecha hacia arriba + bandeja: "restaurar/aplicar" una configuración guardada. -->
    <Geometry x:Key="IconUpload">M11,20 L13,20 L13,13 L16,13 L12,8 L8,13 L11,13 Z M6,4 L18,4 L18,6 L6,6 Z</Geometry>

    <!-- Flecha hacia abajo + bandeja: "importar/traer" un fichero de cliente. -->
    <Geometry x:Key="IconDownload">M11,4 L13,4 L13,11 L16,11 L12,16 L8,11 L11,11 Z M6,18 L18,18 L18,20 L6,20 Z</Geometry>

    <!-- Documento con esquina doblada: "guardar". -->
    <Geometry x:Key="IconDocument">M6,3 L14,3 L18,7 L18,21 L6,21 Z M14,3 L14,7 L18,7 Z</Geometry>

    <!-- Triángulo: "ejecutar". -->
    <Geometry x:Key="IconPlay">M8,5 L19,12 L8,19 Z</Geometry>

    <!-- Triángulo simple hacia la derecha, usado como indicador de "entrar" en las tarjetas de acción. -->
    <Geometry x:Key="IconArrowRight">M7,5 L18,12 L7,19 Z</Geometry>

    <!--
        Iconos de los módulos del menú lateral (sustituyen a las iniciales de 2 letras que se
        usaban antes). Mismo criterio que los de arriba: formas simples propias, sin depender de
        ningún paquete de iconos de terceros. Cada uno se reutiliza también en la cabecera de la
        página central de su módulo (mismo Geometry, dos usos).
    -->

    <!-- Inicio: casa. -->
    <Geometry x:Key="IconHome">M12,4 L21,12 L18,12 L18,20 L6,20 L6,12 L3,12 Z</Geometry>

    <!-- CAM · Mecanizados: tuerca/pieza mecanizada (hexágono). -->
    <Geometry x:Key="IconGearHex">M12,3 L20,7.5 L20,16.5 L12,21 L4,16.5 L4,7.5 Z</Geometry>

    <!-- Configurador de opciones: control deslizante (sliders). -->
    <Geometry x:Key="IconSliders">M4,7 L20,7 L20,8.6 L4,8.6 Z M4,11.2 L15,11.2 L15,12.8 L4,12.8 Z M4,15.4 L20,15.4 L20,17 L4,17 Z</Geometry>

    <!-- Conector de herraje: dos piezas unidas por un enlace. -->
    <Geometry x:Key="IconLink">M4,9 L9,9 L9,15 L4,15 Z M11,11 L15,11 L15,13 L11,13 Z M17,9 L22,9 L22,15 L17,15 Z</Geometry>

    <!-- Control de cambios: portapapeles/checklist. -->
    <Geometry x:Key="IconClipboard">M7,3 L17,3 L17,5 L7,5 Z M5,5 L19,5 L19,21 L5,21 Z</Geometry>

    <!-- Traducción: burbuja de conversación. -->
    <Geometry x:Key="IconChatBubble">M4,5 L20,5 L20,15 L10,15 L6,19 L6,15 L4,15 Z</Geometry>

    <!-- Manillas FKS: manilla de puerta/ventana. -->
    <Geometry x:Key="IconHandle">M4,11 L16,11 L16,13 L4,13 Z M17,8 L23,8 L23,16 L17,16 Z</Geometry>

    <!-- Tarifas/precios: etiqueta. -->
    <Geometry x:Key="IconTag">M3,12 L9,4 L20,4 L20,20 L9,20 Z</Geometry>

    <!-- Ajustes generales: "más opciones" (tres puntos). -->
    <Geometry x:Key="IconDots">M4,10.5 L8,10.5 L8,14.5 L4,14.5 Z M10,10.5 L14,10.5 L14,14.5 L10,14.5 Z M16,10.5 L20,10.5 L20,14.5 L16,14.5 Z</Geometry>

    <!-- Quitar / cerrar: aspa. -->
    <Geometry x:Key="IconClose">M4,6 L6,4 L12,10 L18,4 L20,6 L14,12 L20,18 L18,20 L12,14 L6,20 L4,18 L10,12 Z</Geometry>

    <!-- Limpiar / eliminar: papelera. -->
    <Geometry x:Key="IconTrash">M9,4 L15,4 L15,6 L9,6 Z M5,7 L19,7 L19,9 L5,9 Z M6,9 L18,9 L17,21 L7,21 Z</Geometry>

    <!-- Actualizar / refrescar: flecha circular (arco + punta de flecha), dibujado como un único
         polígono (arco exterior + punta + arco interior de vuelta) para evitar comandos de arco
         SVG; validado con un script de geometría (shapely) para asegurar que no se autointerseca. -->
    <Geometry x:Key="IconRefresh">M3.95,7.35 L5.42,5.42 L7.35,3.95 L9.59,3.02 L12.00,2.70 L14.41,3.02 L16.65,3.95 L18.58,5.42 L20.05,7.35 L20.98,9.59 L21.30,12.00 L20.98,14.41 L20.05,16.65 L18.58,18.58 L16.65,20.05 L14.41,20.98 L12.00,21.30 L9.59,20.98 L7.35,20.05 L5.42,18.58 L2.38,17.33 L7.55,16.45 L8.85,17.46 L10.37,18.09 L12.00,18.30 L13.63,18.09 L15.15,17.46 L16.45,16.45 L17.46,15.15 L18.09,13.63 L18.30,12.00 L18.09,10.37 L17.46,8.85 L16.45,7.55 L15.15,6.54 L13.63,5.91 L12.00,5.70 L10.37,5.91 L8.85,6.54 L7.55,7.55 L6.54,8.85 Z</Geometry>

    <!-- Flechas de navegación del menú CAM3D (mismo estilo lineal que el resto de iconos). -->
    <Geometry x:Key="IconOperations">M4,5 L20,5 L20,7 L4,7 Z M4,11 L20,11 L20,13 L4,13 Z M4,17 L20,17 L20,19 L4,19 Z M2,5 L4,5 L4,7 L2,7 Z M2,11 L4,11 L4,13 L2,13 Z M2,17 L4,17 L4,19 L2,19 Z</Geometry>
    <Geometry x:Key="IconProfiles">M4,3 L10,3 L10,21 L4,21 Z M14,3 L20,3 L20,21 L14,21 Z</Geometry>
    <Geometry x:Key="IconBack">M11,4 L13,6 L8,11 L21,11 L21,13 L8,13 L13,18 L11,20 L3,12 Z</Geometry>

    <!-- Añadir (cruz): "Nuevo perfil" / "Añadir fila". -->
    <Geometry x:Key="IconPlus">M9,3 L15,3 L15,9 L21,9 L21,15 L15,15 L15,21 L9,21 L9,15 L3,15 L3,9 L9,9 Z</Geometry>

    <!-- Duplicar (dos rectángulos superpuestos, sin solape real entre los dos subtrazados para
         que el resultado sea válido con cualquier regla de relleno): catálogo/biblioteca 3D. -->
    <Geometry x:Key="IconDuplicate">M4,4 L14,4 L14,8 L8,8 L8,14 L4,14 Z M8,8 L18,8 L18,18 L8,18 Z</Geometry>

    <!-- ===================== Estilos de texto ===================== -->

    <Style x:Key="RotoPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource RotoInkBrush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="RotoSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource RotoInkBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- ===================== Tarjeta de contenido ===================== -->

    <Style x:Key="RotoCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RotoCardBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="1" Opacity="0.10" Color="#000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Botón de acción (primario) ===================== -->

    <Style x:Key="RotoButtonPrimary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource RotoRedBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource RotoRedDarkBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Botón de acción (secundario) ===================== -->

    <Style x:Key="RotoButtonSecondary" TargetType="Button">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource RotoInkBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#F2F2F4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Tarjeta de acción, clicable en toda su superficie ===================== -->
    <!-- Igual que RotoCard visualmente, pero es un Button de verdad: el área clicable es toda la
         tarjeta (icono + título + descripción + indicador inferior), no solo un botón pequeño
         dentro de ella. Usada en páginas de tipo "menú" con varias acciones en tarjetas grandes
         (p.ej. Configurador de opciones). -->

    <Style x:Key="RotoActionCard" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource RotoCardBackgroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10" Padding="22"
                            BorderBrush="Transparent" BorderThickness="1.5">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="1" Opacity="0.10" Color="#000000" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource RotoRedBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#FAFAFB" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Elemento del menú lateral de navegación ===================== -->
    <!-- ListBoxItem con plantilla propia: icono en forma de "monograma" (círculo con 2 letras y
         color propio, ver NavIconBadge en cada página XAML) + texto, resaltado rojo cuando está
         seleccionado. Se usa dentro de un ListBox (ver MainWindow.xaml). -->

    <Style x:Key="RotoNavItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="10,2" />
        <Setter Property="Foreground" Value="#D7D9DE" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource RotoNavHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource RotoNavSelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox" x:Key="RotoNavList">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource RotoNavItem}" />
    </Style>

    <!-- Insignia circular con 2 letras (monograma), color propio por módulo: evita depender de
         cualquier fuente/paquete de iconos de terceros. -->
    <Style x:Key="RotoNavBadge" TargetType="Border">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="15" />
    </Style>

    <!-- Botón de icono para la cabecera oscura (p.ej. "Actualizar" junto a la conexión): fondo
         transparente, resalte claro semitransparente al pasar el ratón (mismo criterio que
         RotoNavHoverBrush) para que se note sobre el fondo oscuro. -->
    <Style x:Key="RotoHeaderIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="15">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource RotoNavHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ComboBox de idioma (cabecera) ===================== -->

    <Style x:Key="RotoComboHeader" TargetType="ComboBox">
        <Setter Property="Background" Value="#2B2E35" />
        <!-- Negro (no blanco): con el fondo claro real del control (tanto el cuadro cerrado como
             la lista desplegable, que WPF no pinta con el Background de arriba salvo que se
             retemplatice por completo) el texto blanco quedaba invisible. -->
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#454851" />
    </Style>

    <!-- ComboBox de filtro sobre fondo claro (p.ej. Lado/Rol en el catálogo de operaciones 3D):
         por defecto WPF no centra en vertical el texto del elemento seleccionado dentro del
         cuadro cerrado (queda pegado arriba), y sin un ancho explícito moderado tiende a verse
         demasiado ancho para el texto corto que suele contener. -->
    <Style x:Key="RotoComboFilter" TargetType="ComboBox">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

    <!-- ===================== Controles de formulario/edición ===================== -->
    <!-- Usados por las primeras páginas "reales" migradas (p.ej. Configurador de opciones):
         cuadro de texto, lista simple, y DataGrid, con el mismo look&feel de tarjeta/borde suave
         que el resto de la suite. Todo WPF estándar, sin dependencias externas. -->

    <Style x:Key="RotoTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource RotoInkBrush}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{StaticResource RotoBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RotoListItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Foreground" Value="{StaticResource RotoInkBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#F2F2F4" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource RotoRedBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RotoList" TargetType="ListBox">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource RotoBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource RotoListItem}" />
    </Style>

    <Style x:Key="RotoDataGrid" TargetType="DataGrid">
        <!-- El contenido de celda (texto, checkbox, combo) no hereda automáticamente el centrado
             vertical de CellStyle.VerticalContentAlignment de abajo: por defecto se estira
             (VerticalAlignment=Stretch) y el propio control dibuja su glifo pegado arriba dentro
             de esa área estirada. Se fuerza aquí, vía estilos implícitos, que el contenido de
             cualquier celda se centre verticalmente en vez de estirarse. -->
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style.Resources>
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource RotoBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowHeight" Value="34" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource RotoBorderBrush}" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="IsReadOnly" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowBackground" Value="White" />
        <Setter Property="AlternatingRowBackground" Value="#F8F9FA" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F2F2F4" />
                    <Setter Property="Foreground" Value="{StaticResource RotoInkBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="8,7" />
                    <Setter Property="BorderBrush" Value="{StaticResource RotoBorderBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="8,5" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FDE7E7" />
                            <Setter Property="Foreground" Value="{StaticResource RotoInkBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Estilo de texto para el TextBlock que genera automáticamente DataGridTextColumn (y el modo
         "no edición" de DataGridComboBoxColumn) en cada celda. Los estilos implícitos de arriba
         (Style.Resources dentro de RotoDataGrid) SÍ centran el CheckBox/Button de las columnas de
         plantilla, pero DataGridBoundColumn asigna su propio estilo a ese TextBlock al generarlo,
         lo que evita que herede el estilo implícito por tipo. Hay que referenciar este estilo de
         forma explícita con ElementStyle="{StaticResource RotoDataGridCellText}" en cada
         DataGridTextColumn / DataGridComboBoxColumn para que el texto quede centrado en vertical. -->
    <Style x:Key="RotoDataGridCellText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Igual que RotoDataGridCellText, pero para DataGridComboBoxColumn: a pesar de lo que
         cabría esperar por analogía con DataGridTextColumn, el elemento que genera esta columna
         en modo "no edición" es un ComboBox de verdad (no un TextBlock) — solo que sin flecha
         visible y sin poder abrirse hasta entrar en modo edición. Aplicar aquí un estilo con
         TargetType="TextBlock" lanza en tiempo de ejecución "El TargetType 'TextBlock' no
         coincide con el tipo de elemento 'ComboBox'". -->
    <Style x:Key="RotoDataGridCellCombo" TargetType="ComboBox">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Igual que RotoDataGridCellText/RotoDataGridCellCombo, pero para el EDITOR de la celda (el
         TextBox real que aparece al entrar en modo edición), no para el elemento de solo lectura:
         DataGridBoundColumn distingue ElementStyle (modo visualización) de EditingElementStyle
         (modo edición) y son elementos totalmente distintos, así que centrar uno no centra el
         otro. Sin esto, el texto queda pegado arriba justo al editar una celda. -->
    <Style x:Key="RotoDataGridCellEditText" TargetType="TextBox">
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Insignia circular con 2 letras (monograma) para cabeceras de página, mismo criterio que
         RotoNavBadge pero un poco más grande para usarla fuera del menú lateral. -->
    <Style x:Key="RotoPageBadge" TargetType="Border">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
    </Style>

</ResourceDictionary>
