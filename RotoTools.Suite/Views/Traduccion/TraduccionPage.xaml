<UserControl
    x:Class="RotoTools.Suite.Views.Traduccion.TraduccionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource RotoContentBackgroundBrush}">

    <!--
        Sustituye a TraduccionMenu.cs/.Designer.cs (WinForms): mismo comportamiento y misma lógica
        de negocio (reutilizada tal cual vía RotoTools.Helpers/RotoTools.XmlLoader/
        RotoTools.LocalizationManager por ProjectReference, y NPOI para generar el Excel, ya
        referenciado directamente en RotoTools.Suite.csproj). El original era un único formulario
        fijo (624x265, FixedSingle) con 3 botones de icono en fila (Cargar XML, Traducir XML,
        Generar plantilla); aquí, mismo criterio que ConectorHerrajePage/CamPage: barra de carga de
        XML arriba (botón primario + etiqueta de estado) y las 2 acciones como tarjetas grandes
        debajo.

        "Traducir XML" y "Generar plantilla" no comprueban aquí si hay un XML cargado con un
        mensaje de aviso: igual que el original (if (!xmlCargado) return;), pulsar la tarjeta antes
        de cargar un XML simplemente no hace nada. Tampoco se deshabilita el botón "Traducir XML"
        mientras se genera la plantilla (EnableButtons en el original solo alterna btn_LoadXml y
        btn_GenerarPlantillaExcel, no btn_Traducir): se mantiene tal cual, sin "corregirlo".
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,32">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Border Style="{StaticResource RotoPageBadge}" Background="#C2185B" Margin="0,0,16,0">
                    <Path Data="{StaticResource IconChatBubble}" Fill="White" Width="20" Height="20" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitulo" Style="{StaticResource RotoPageTitle}" Margin="0" />
                    <TextBlock x:Name="TxtSubtitulo" Foreground="{StaticResource RotoGrayBrush}" FontSize="13" />
                </StackPanel>
            </StackPanel>

            <!-- Antes btn_LoadXml + lbl_Xml: mismo patrón "botón primario + etiqueta de estado"
                 que ConectorHerrajePage/CamPage. -->
            <Border Background="White" BorderBrush="{StaticResource RotoBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,20">
                <DockPanel LastChildFill="False">
                    <Button x:Name="BtnLoadXml" DockPanel.Dock="Left" Style="{StaticResource RotoButtonPrimary}"
                            Click="BtnLoadXml_Click" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolderOpen}" Fill="White" Width="16" Height="16" Stretch="Uniform"
                                  Margin="0,0,8,0" />
                            <TextBlock x:Name="TxtBtnCargarXml" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="LblXml" DockPanel.Dock="Left" VerticalAlignment="Center"
                               Foreground="{StaticResource RotoGrayBrush}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- Antes lbl_TraducirXML/btn_Traducir y lbl_GenerarPlantilla/btn_GenerarPlantillaExcel,
                 mismo orden visual que el original (Traducir XML encima, Generar plantilla debajo). -->
            <UniformGrid Columns="2" Rows="1">
                <Button x:Name="BtnTraducir" Style="{StaticResource RotoActionCard}" Margin="0,0,6,0"
                        Click="BtnTraducir_Click">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="20" Background="#1976D2" Margin="0,0,0,14">
                            <Path Data="{StaticResource IconRefresh}" Fill="White" Width="18" Height="18" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="TxtCard1Titulo" Style="{StaticResource RotoSectionTitle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtCard1Desc" Foreground="{StaticResource RotoGrayBrush}" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button x:Name="BtnGenerarPlantillaExcel" Style="{StaticResource RotoActionCard}" Margin="6,0,0,0"
                        Click="BtnGenerarPlantillaExcel_Click">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="20" Background="#2E7D32" Margin="0,0,0,14">
                            <Path Data="{StaticResource IconExcelDoc}" Fill="White" Width="18" Height="18" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="TxtCard2Titulo" Style="{StaticResource RotoSectionTitle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtCard2Desc" Foreground="{StaticResource RotoGrayBrush}" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
